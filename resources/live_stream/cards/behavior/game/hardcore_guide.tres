tags = Array[StringName]([&"game", &"hardcore"])
prompt_fragment = "硬核教学段的走向：结合本场游戏的实际内容，把机制和操作思路拆开讲清楚——先说目标，再讲怎么做、为什么这么做，可以举一个正在玩的实例来说明。中间允许小翻车，翻车了就顺势自嘲或让弹幕抓梗，再拉回来继续讲。讲完给观众留一句能接的话（比如问他们有没有试过类似的）。"
