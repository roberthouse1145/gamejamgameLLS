content_id = &"material_cozy_game"
display_name = "悠闲岛生活存档"
description = "适合慢慢逛、慢慢聊的休闲游戏进度。"
icon = ExtResource("4")
tags = Array[StringName]([&"game", &"casual"])
prompt_fragment = "悠闲岛生活模拟游戏的一份存档。游戏内容包括：河边钓鱼、自家田里种稻子、岛上各处闲逛、与居民闲聊；节奏缓慢、没有战斗和压力，核心是日常劳作与岛上的温情互动。存档里留有不少细节：一片特意保留没砍的树、海边能钓到蓝鳟鱼的水域、通关后老爷爷会来搭桥的传说。这类素材适合慢慢逛、慢慢聊，可能触发放松的闲聊氛围和对岛上日常的讨论。"
