[gd_resource type="Resource" script_class="WebPageResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/apps/browser/web_page_resource.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
url = "browser://home"
title = "PixelNet - 起始页"
hint = "PixelNet 起始页，聚合今日热点、AGJ 入口和最近浏览内容。"
content = "<vbox sep=0>

  <panel bg=#080B12>
    <margin 40>
      <vbox sep=6>
        <hbox sep=10>
          <label size=28 color=#ECEEF8>PixelNet</label>
          <vbox width=20><label size=20 color=#3D4460>|</label></vbox>
          <vbox width=40><link size=16 color=#7A82A0 action=open_url url=gamejam://news>资讯</link></vbox>
          <vbox width=40><link size=16 color=#7A82A0 action=open_url url=gamejam://schedule>赛程</link></vbox>
          <vbox width=40><link size=16 color=#7A82A0 action=open_url url=gamejam://faq>帮助</link></vbox>
          <vbox width=40><link size=16 color=#7A82A0 action=open_history_page>历史</link></vbox>
        </hbox>
      </vbox>
    </margin>
  </panel>

  <panel bg=#0A0D18>
    <margin 40>
      <vbox sep=4>
        <label size=18 color=#5B8AFF>LanJing Node  |  今日热点</label>
        <label size=15 color=#5A6580>校园网节点已同步 AGJ 报名公告，创作者社区热度持续上升。</label>
      </vbox>
    </margin>
  </panel>

  <panel bg=#080B12>
    <margin 40>
      <vbox sep=28>

        <vbox sep=12>
          <hbox sep=10>
            <panelcontainer bg=#1E3A8A border=#3D6FFF shrink><margin 4><label size=14 color=#3D6FFF nowrap>站点速览</label></margin></panelcontainer>
            <label size=16 color=#3D4460>━━━━━━━━━━━━━━━━━━━━</label>
          </hbox>
          <hbox sep=10>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 16>
                <vbox sep=4>
                  <link size=17 color=#ECEEF8 action=open_url url=gamejam://news>赛事资讯</link>
                  <label size=13 color=#5A6580>报名开放、规则预告、官方公告</label>
                </vbox>
              </margin>
            </panel>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 16>
                <vbox sep=4>
                  <link size=17 color=#ECEEF8 action=open_url url=gamejam://schedule>官方赛程</link>
                  <label size=13 color=#5A6580>报名、主题公布、Demo 节点</label>
                </vbox>
              </margin>
            </panel>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 16>
                <vbox sep=4>
                  <link size=17 color=#ECEEF8 action=open_url url=gamejam://faq>帮助说明</link>
                  <label size=13 color=#5A6580>规则问答、素材限制、提交须知</label>
                </vbox>
              </margin>
            </panel>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 16>
                <vbox sep=4>
                  <link size=17 color=#ECEEF8 action=open_history_page>浏览记录</link>
                  <label size=13 color=#5A6580>刚才看过的页面会留在这里</label>
                </vbox>
              </margin>
            </panel>
          </hbox>
        </vbox>

        <vbox sep=12>
          <hbox sep=10>
            <panelcontainer bg=#7A3010 border=#E8622A shrink><margin 4><label size=14 color=#E8622A nowrap>TRENDING</label></margin></panelcontainer>
            <label size=14 color=#3D4460>今日热搜</label>
            <label size=16 color=#3D4460>━━━━━━━━━━━━━━━━━━━━</label>
          </hbox>

          <panel bg=#0D1020 border=#1A1F35>
            <margin 20>
              <vbox sep=10>
                <label size=22 color=#ECEEF8>AGJ 2027 新星赛道报名开启</label>
                <label size=15 color=#7A82A0>官方页面显示，本届新星赛道将把评审重点放回创意本身。报名页开放后，校园网和创作者社区都开始讨论队伍规模、主题猜测和阶段性 Demo 提交。</label>
              </vbox>
            </margin>
          </panel>

          <hbox sep=12>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 20>
                <vbox sep=10>
                  <label size=20 color=#ECEEF8>校园热搜</label>
                  <label size=14 color=#7A82A0>#新星赛道报名  #组队招募  #统一素材包  #阶段性Demo</label>
                </vbox>
              </margin>
            </panel>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 20>
                <vbox sep=10>
                  <label size=20 color=#ECEEF8>创作者在看</label>
                  <label size=14 color=#7A82A0>有人在猜主题，有人在整理避坑清单，也有人已经开始找队友和晒企划草图。</label>
                </vbox>
              </margin>
            </panel>
          </hbox>
        </vbox>

        <label size=13 color=#3D4460 align=center>PixelNet Portal v3.2  |  Arcade Grand Jam 2027 Official Partner</label>
        <spacer 20/>

      </vbox>
    </margin>
  </panel>

</vbox>"
design_prompt = ""
searchable = false
search_keywords = PackedStringArray()
linked_urls = PackedStringArray("gamejam://news", "gamejam://schedule", "gamejam://faq")
