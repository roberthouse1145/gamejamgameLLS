[gd_resource type="Resource" script_class="WebPageResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/apps/browser/web_page_resource.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
url = "browser://home"
title = "PixelNet - 浏览首页"
hint = "浏览器主页，用来查看赛事资讯、赛程、帮助和剧情网页。"
content = "<vbox sep=0>

  <panel bg=#080B12>
    <margin 40>
      <vbox sep=6>
        <hbox sep=10>
          <label size=28 color=#ECEEF8>PixelNet</label>
          <vbox width=20><label size=20 color=#3D4460>|</label></vbox>
          <vbox width=40><link size=16 color=#7A82A0 action=open_url url=gamejam://news>资讯</link></vbox>
          <vbox width=40><link size=16 color=#7A82A0 action=open_url url=gamejam://schedule>赛程</link></vbox>
          <vbox width=40><link size=16 color=#7A82A0 action=open_url url=gamejam://faq>帮助</link></vbox>
          <vbox width=40><link size=16 color=#7A82A0 action=open_history_page>历史</link></vbox>
        </hbox>
      </vbox>
    </margin>
  </panel>

  <panel bg=#0A0D18>
    <margin 40>
      <vbox sep=4>
        <label size=18 color=#5B8AFF>Arcade Grand Jam 2027  路  新星赛道</label>
        <label size=15 color=#5A6580>已开放报名、可查看公告与赛程。浏览器现在只承担网页与叙事页面的访问功能。</label>
      </vbox>
    </margin>
  </panel>

  <panel bg=#080B12>
    <margin 40>
      <vbox sep=28>

        <vbox sep=12>
          <hbox sep=10>
            <panelcontainer bg=#1E3A8A border=#3D6FFF shrink><margin 4><label size=14 color=#3D6FFF nowrap>快速导航</label></margin></panelcontainer>
            <label size=16 color=#3D4460>鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣</label>
          </hbox>
          <hbox sep=10>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 16>
                <vbox sep=4>
                  <label size=17 color=#ECEEF8>赛事资讯</label>
                  <label size=13 color=#5A6580>NEWS / ANNOUNCEMENT</label>
                </vbox>
              </margin>
            </panel>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 16>
                <vbox sep=4>
                  <label size=17 color=#ECEEF8>官方赛程</label>
                  <label size=13 color=#5A6580>SCHEDULE</label>
                </vbox>
              </margin>
            </panel>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 16>
                <vbox sep=4>
                  <label size=17 color=#ECEEF8>帮助说明</label>
                  <label size=13 color=#5A6580>FAQ</label>
                </vbox>
              </margin>
            </panel>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 16>
                <vbox sep=4>
                  <label size=17 color=#ECEEF8>浏览记录</label>
                  <label size=13 color=#5A6580>HISTORY</label>
                </vbox>
              </margin>
            </panel>
          </hbox>
        </vbox>

        <vbox sep=12>
          <hbox sep=10>
            <panelcontainer bg=#7A3010 border=#E8622A shrink><margin 4><label size=14 color=#E8622A nowrap>当前说明</label></margin></panelcontainer>
            <label size=14 color=#3D4460>浏览器定位</label>
            <label size=16 color=#3D4460>鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣鈹佲攣</label>
          </hbox>

          <panel bg=#0D1020 border=#1A1F35>
            <margin 20>
              <vbox sep=10>
                <label size=22 color=#ECEEF8>浏览器只负责打开网页</label>
                <label size=15 color=#7A82A0>你可以继续用它查看报名页、官方公告、赛程、帮助页和其他剧情网页。需要消耗 AP 的互联网行动，已经迁移到独立的 Community 应用中。</label>
              </vbox>
            </margin>
          </panel>

          <hbox sep=12>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 20>
                <vbox sep=10>
                  <label size=20 color=#ECEEF8>网页浏览</label>
                  <label size=14 color=#7A82A0>从上方导航继续查看资讯、赛程和帮助页面。这些内容不会消耗行动力，也更适合承接叙事流程。</label>
                </vbox>
              </margin>
            </panel>
            <panel bg=#0D1020 border=#1A1F35 fill>
              <margin 20>
                <vbox sep=10>
                  <label size=20 color=#ECEEF8>Community 应用</label>
                  <label size=14 color=#7A82A0>论坛围观、发布宣传、查看赛事动向等互联网行动，已经统一放到单独的桌面应用中处理。</label>
                </vbox>
              </margin>
            </panel>
          </hbox>
        </vbox>

        <label size=13 color=#3D4460 align=center>PixelNet Portal v3.2  路  Arcade Grand Jam 2027 Official Partner</label>
        <spacer 20/>

      </vbox>
    </margin>
  </panel>

</vbox>"
design_prompt = ""
searchable = false
search_keywords = PackedStringArray()
linked_urls = PackedStringArray("gamejam://news", "gamejam://schedule", "gamejam://faq")
