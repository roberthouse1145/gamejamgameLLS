[gd_resource type="Resource" script_class="WebPageResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/apps/browser/web_page_resource.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
url = "gamejam://news"
title = "AGJ 2025 - 新闻动态"
hint = "Arcade Grand Jam 2025 新星赛道的最新新闻与公告。"
content = "<vbox sep=0>

  <panel bg=#080B12>
    <margin 48>
      <vbox sep=6>
        <hbox sep=10>
          <label size=24 color=#ECEEF8>AGJ</label>
          <label size=13 color=#E8622A>2025</label>
          <label size=15 color=#3D4460>|</label>
          <link size=13 color=#7A82A0 action=open_url url=gamejam://signup>REGISTRATION</link>
          <link size=13 color=#7A82A0 action=open_url url=gamejam://schedule>SCHEDULE</link>
          <label size=13 color=#5B8AFF>NEWS</label>
          <link size=13 color=#7A82A0 action=open_url url=gamejam://faq>FAQ</link>
        </hbox>
      </vbox>
    </margin>
  </panel>

  <panel bg=#0A0D18>
    <margin 48>
      <vbox sep=8>
        <label size=40 color=#ECEEF8>NEWS</label>
        <label size=18 color=#5B8AFF>新闻动态</label>
      </vbox>
    </margin>
  </panel>

  <panel bg=#080B12>
    <margin 48>
      <vbox sep=28>

        <panel bg=#0D1020 border=#1A1F35>
          <margin 28>
            <vbox sep=16>
              <hbox sep=10>
                <panelcontainer bg=#1E3A8A border=#3D6FFF><margin 3><label size=12 color=#3D6FFF nowrap>ANNOUNCEMENT</label></margin></panelcontainer>
                <label size=13 color=#7A82A0>2025.06.01</label>
              </hbox>
              <label size=24 color=#ECEEF8>Arcade Grand Jam 2025 新星赛道正式启动</label>
              <panel bg=#141828><margin 0><spacer 1/></margin></panel>
              <label size=15 color=#7A82A0>经过数月筹备，Arcade Grand Jam 2025 新星赛道于今日正式面向全球高校学生开放报名。本届赛事延续了 AGJ 一贯的公平竞技理念，所有参赛队伍将使用统一的官方 AVG 引擎和素材包进行创作。</label>
              <label size=15 color=#7A82A0>本届新星赛道的核心变化在于：全面限制外部资源导入，要求参赛者在 60 天内以 2 人小队形式完成一部原创 AVG 作品。组委会希望通过这种方式，将比赛的焦点从技术堆砌和资源比拼，拉回到创意本身。</label>
              <label size=15 color=#7A82A0>赛事总奖金池超过 50,000 元人民币，涵盖最佳作品、最佳叙事、最佳视觉表现、社区人气等多个奖项。所有获奖作品将在 AGJ 官方平台进行展示，并有机会获得行业合作伙伴的孵化支持。</label>
              <label size=15 color=#7A82A0>报名现已开放，截止日期前均可提交。每位参赛者只能加入一支队伍，报名信息提交后不可修改。</label>
              <spacer 8/>
              <hbox sep=12>
                <panelcontainer bg=#1E3A8A border=#3D6FFF><margin 6><link size=13 color=#5B8AFF nowrap action=open_url url=gamejam://signup>立即报名</link></margin></panelcontainer>
                <panelcontainer bg=#7A3010 border=#E8622A><margin 6><link size=13 color=#E8622A nowrap action=open_url url=gamejam://schedule>查看赛程</link></margin></panelcontainer>
              </hbox>
            </vbox>
          </margin>
        </panel>

        <label size=13 color=#3D4460 align=center>ARCADE GRAND JAM 2025  |  support@arcadegrandjam.com</label>
        <spacer 24/>

      </vbox>
    </margin>
  </panel>

</vbox>"
design_prompt = ""
searchable = false
search_keywords = PackedStringArray("gamejam", "news", "新闻", "公告", "动态")
linked_urls = PackedStringArray("gamejam://signup", "gamejam://schedule", "gamejam://faq")
