[gd_resource type="Theme" format=3]

; ============================================================
; DeepCode Dark Theme
; 适用于: deepcode_app.tscn 及其子组件
; 颜色参考: deepcode_theme_utils.gd (Claude-inspired warm dark)
; ============================================================

; --- Panel: 主背景 ---
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_main_bg"]
bg_color = Color(0.169, 0.169, 0.169, 1)
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0

; --- Panel: Sidebar ---
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_sidebar"]
bg_color = Color(0.145, 0.145, 0.145, 1)
border_width_right = 1
border_color = Color(0.251, 0.251, 0.251, 1)

; --- Panel: Debug panel ---
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_debug_panel"]
bg_color = Color(0.145, 0.145, 0.145, 1)
border_width_left = 1
border_color = Color(0.251, 0.251, 0.251, 1)

; --- LineEdit: normal ---
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_input_normal"]
bg_color = Color(0.239, 0.239, 0.239, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_left = 16
corner_radius_bottom_right = 16
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.314, 0.314, 0.314, 1)
content_margin_left = 16.0
content_margin_top = 10.0
content_margin_right = 16.0
content_margin_bottom = 10.0

; --- LineEdit: focus ---
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_input_focus"]
bg_color = Color(0.239, 0.239, 0.239, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_left = 16
corner_radius_bottom_right = 16
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.831, 0.647, 0.455, 1)
content_margin_left = 16.0
content_margin_top = 10.0
content_margin_right = 16.0
content_margin_bottom = 10.0

; --- Button: Send normal ---
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_send_normal"]
bg_color = Color(0.831, 0.647, 0.455, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_left = 16
corner_radius_bottom_right = 16
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0

; --- Button: Send hover ---
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_send_hover"]
bg_color = Color(0.878, 0.722, 0.541, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_left = 16
corner_radius_bottom_right = 16
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0

; --- Button: Send pressed ---
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_send_pressed"]
bg_color = Color(0.748, 0.582, 0.409, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_left = 16
corner_radius_bottom_right = 16
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0

; --- StyleBoxEmpty ---
[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_empty"]

[resource]
; Panel
Panel/styles/panel = SubResource("StyleBoxFlat_main_bg")

; PanelContainer — 默认与 Panel 共用主背景色
PanelContainer/styles/panel = SubResource("StyleBoxFlat_main_bg")

; Label
Label/colors/font_color = Color(0.925, 0.925, 0.925, 1)
Label/font_sizes/font_size = 14

; LineEdit
LineEdit/styles/normal = SubResource("StyleBoxFlat_input_normal")
LineEdit/styles/focus = SubResource("StyleBoxFlat_input_focus")
LineEdit/styles/read_only = SubResource("StyleBoxFlat_input_normal")
LineEdit/colors/font_color = Color(0.925, 0.925, 0.925, 1)
LineEdit/colors/font_placeholder_color = Color(0.439, 0.439, 0.439, 1)
LineEdit/colors/caret_color = Color(0.831, 0.647, 0.455, 1)
LineEdit/font_sizes/font_size = 15

; Button (send button defaults)
Button/styles/normal = SubResource("StyleBoxFlat_send_normal")
Button/styles/hover = SubResource("StyleBoxFlat_send_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_send_pressed")
Button/styles/focus = SubResource("StyleBoxEmpty_empty")
Button/colors/font_color = Color(0.102, 0.102, 0.102, 1)
Button/colors/font_hover_color = Color(0.102, 0.102, 0.102, 1)
Button/colors/font_pressed_color = Color(0.102, 0.102, 0.102, 1)
Button/colors/font_focus_color = Color(0.102, 0.102, 0.102, 1)
Button/colors/font_hover_pressed_color = Color(0.102, 0.102, 0.102, 1)
Button/font_sizes/font_size = 14

; TabBar
TabBar/colors/font_selected_color = Color(0.831, 0.647, 0.455, 1)
TabBar/colors/font_unselected_color = Color(0.439, 0.439, 0.439, 1)
TabBar/font_sizes/font_size = 12

; RichTextLabel
RichTextLabel/colors/default_color = Color(0.627, 0.627, 0.627, 1)
RichTextLabel/font_sizes/normal_font_size = 12
RichTextLabel/font_sizes/mono_font_size = 11
