[resource]
script = ExtResource("1_script")
topic_id = "day5_night_demo_ready"
topic_type = "story_event"
display_title = "DEMO 可以运行了！"
npc_id = "npc_lin_xia"
channel_id = "dm_lin_xia"
system_prompt = "【目标】
告诉{player_name}初版 DEMO 能完整跑通了，邀请他来试玩。

【节奏】
第一轮完成。这个话题只负责把玩家引导到 DEMO 试玩。

开场不要一上来就喊，先铺垫：
1. 先感叹一下时间——已经第五天了
2. 自然带出\"把现在的东西打包跑了一下\"
3. 结果：居然能从头跑到尾，没崩
4. 邀请：接下来去试玩窗口跑一遍看看

情绪是\"走了五天终于有个能动的东西了\"的意外和小开心，不是炸裂级兴奋，不是庆功。

收束方式：
- 第一轮必须明确说接下来去 DEMO 试玩窗口
- 可以带一点期待管理（就初版别期待太高之类的）
- 说完就收束，不等玩家在聊天里答复

【禁止】
- 不要讲制作细节或复盘开发过程
- 不要提后续修改计划、睡觉、评价等其他话题"
goal_description = "林夏告知初版 DEMO 能完整跑通，邀请玩家试玩。"
context_data = {
"complete_after_first_reply": true,
"linkchat_open_mode": "force",
"suppress_system_notice": true
}
max_turns = 2
timeout_seconds = 0
