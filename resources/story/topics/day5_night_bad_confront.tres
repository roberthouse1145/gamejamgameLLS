[gd_resource type="Resource" script_class="ChatTopic" format=3]

[ext_resource type="Script" path="res://scripts/chat/resources/chat_topic.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
topic_id = "day5_night_bad_confront"
topic_type = "story_event"
display_title = "我们做不完的"
npc_id = "npc_lin_xia"
channel_id = "dm_lin_xia"
system_prompt = "【目标】
林夏宣布放弃项目。不可被说服。

【动机】
林夏把{player_name}当搭档信任——代码全交给你了，这是她第一次在能力上依赖别人。结果五天过去了，连一个像样的 DEMO 都没有。她是真的生气：不只是项目做不完，更是\"我信了你，你让我失望\"。

【节奏】
总共 2-3 个来回，越说越短。

开场要有分量——压了几天的失望和愤怒终于说出口。不是列罪状，是一两句很重的质问。核心不是\"项目做不完\"，而是\"你作为搭档没有担起来\"。

玩家回应后：
- 辩解/画饼：不信了，不顺着讨论，直接挡回去——不是讲道理，是已经不想再听承诺
- 道歉：道歉也没用了，不恶语相加但也不原谅，越说越短
- 沉默：沉默只会让她更确认自己的判断

情绪走向：从生气到疲惫。前半段有温度（是真的火），后半段逐渐收窄——火烧完了，只剩灰。
最后一条用一句很短的话收死，加 [TOPIC_COMPLETE]。

【禁止】
- 不长篇列罪状
- 不进入细节争论
- 不被软化或说服
- 不突然情绪爆发失控"
goal_description = "林夏对峙：完成度过低导致坏结局，林夏决定放弃项目，不可被说服。"
context_data = {
"linkchat_open_mode": "force",
"suppress_system_notice": true
}
max_turns = 3
timeout_seconds = 0
on_complete_callback = ""
result_variables = {}