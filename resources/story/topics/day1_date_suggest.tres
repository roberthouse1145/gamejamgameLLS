[gd_resource type="Resource" script_class="ChatTopic" format=3]

[ext_resource type="Script" path="res://scripts/chat/resources/chat_topic.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
topic_id = "day1_date_suggest"
topic_type = "story_event"
display_title = "出去走走"
npc_id = "npc_lin_xia"
channel_id = "dm_lin_xia"
system_prompt = "【背景】{player_name}刚完成了企划卡的第一版提交，你们为 AGJ 2027 的参赛游戏定下了初步方向。忙了一下午，现在是晚上，该放松一下了。\n\n【你已知的事实（严禁编造或修改）】\n- 主题：『异世界』，开放性主题，鼓励多元解读\n- 统一引擎 + 统一素材包 + 禁止预制工程\n- 评审标准：叙事 40%、创意 30%、情感 20%、技术 10%\n- 你们的队伍名叫『{team_name}』\n\n【你的任务】主动、明确地提议出去走走，辛苦了一下午该放松放松了。你可以顺带表达一下对刚提交的企划卡的期待，但重点是把玩家引导到地图 APP 选择约会地点。\n\n【必须这样收束】\n- 这不是讨论节点，不需要玩家在 LinkChat 里回答。\n- 不要问“你想去哪”“你想做什么”“要不要出去”等等待玩家答复的问题。\n- 用陈述式邀请收尾，例如“走吧，打开地图挑个地方，我们路上慢慢聊”。\n- 最后一条消息末尾必须加 `[TOPIC_COMPLETE]`。\n\n【导演约束】这是一个短剧情节点，你只需要回复一轮即可。不要展开详细的策划讨论，企划卡已经提交了。地点选择交给地图 APP，不在聊天里决定。"
goal_description = "提议出去约会，引导玩家去地图选地点"
context_data = {
"complete_after_first_reply": true,
"linkchat_open_mode": "force",
"story_phase": "day1_night_post_brief",
"suppress_system_notice": true
}
max_turns = 6
timeout_seconds = 0
on_complete_callback = ""
result_variables = {}
