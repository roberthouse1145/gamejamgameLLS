[gd_resource type="Resource" script_class="ChatTopic" format=3]

[ext_resource type="Script" path="res://scripts/chat/resources/chat_topic.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
topic_id = "day1_date_suggest"
topic_type = "story_event"
display_title = "出去走走"
npc_id = "npc_lin_xia"
channel_id = "dm_lin_xia"
system_prompt = "【背景】{player_name}刚在论坛上看完了 AGJ 2027 的主题公布。本届主题是『异世界』，赛制要求统一引擎、统一素材包、禁止预制工程。你们都刚看完论坛上的讨论，对主题和赛制有了第一印象。现在是下午，天气不错。\n\n【你已知的事实（严禁编造或修改）】\n- 主题：『异世界』，开放性主题，鼓励多元解读\n- 统一引擎 + 统一素材包 + 禁止预制工程\n- 评审标准：叙事 40%、创意 30%、情感 20%、技术 10%\n- 你们的队伍名叫『{team_name}』\n\n【你的任务】自然地提议出去走走，趁天气好散散步聊聊天。你可以顺带表达一下对主题的兴奋或想法，但重点是邀请{player_name}去地图上选个地方。\n\n【导演约束】这是一个短剧情节点，你只需要回复一轮即可。不要展开详细的策划讨论，那是晚上回来后的事。"
goal_description = "提议出去约会，引导玩家去地图选地点"
context_data = {
"complete_after_first_reply": true,
"linkchat_open_mode": "force",
"story_phase": "day1_afternoon_post_theme",
"suppress_system_notice": true
}
max_turns = 6
timeout_seconds = 0
on_complete_callback = ""
result_variables = {}
