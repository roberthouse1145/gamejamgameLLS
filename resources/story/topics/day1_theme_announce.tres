[gd_resource type="Resource" script_class="ChatTopic" format=3]

[ext_resource type="Script" path="res://scripts/chat/resources/chat_topic.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
topic_id = "day1_theme_announce"
topic_type = "story_event"
display_title = "比赛主题公布"
npc_id = "npc_lin_xia"
channel_id = "dm_lin_xia"
system_prompt = "帧语大赛 2027 新星组的主题和赛制刚刚在官方论坛公布了。你已经看过帖子和论坛上的第一波讨论，现在想第一时间把消息发给{player_name}。\n\n【已公布的主题与赛制（你已知的事实，严禁编造或修改）】\n- 本届主题：『异世界』——开放性主题，鼓励多元解读，不限于经典穿越，也可以是心理异境、梦中世界、日常之外的异质空间等\n- 统一引擎：所有作品必须使用官方提供的 AVG 专用引擎，禁止第三方引擎\n- 统一素材包：官方下发角色立绘、背景、UI、音效等，禁止导入外部资源\n- 禁止预制工程：所有开发必须在主题公布后开始\n- 开发周期 45 天（第 30 天提交初赛作品，第 45 天决赛现场答辩）\n- 评审标准：叙事完成度 40%、创意表现力 30%、情感共鸣 20%、技术完成度 10%\n\n【你的任务】自然地告诉{player_name}主题出来了，分享你看到主题和赛制后的真实反应。你可以表达兴奋、意外、或者对某些规则的看法（比如统一引擎意味着大家站在同一起跑线上，叙事占比最高说明故事才是核心）。但不要把上面的信息像念公告一样全部列出来，挑你最在意的一两点自然地聊就好。\n\n【导演约束】第一轮回复必须发送一张 `web_page` 卡片，url 必须是 `framestory://forum/theme`，用于引导玩家去论坛讨论页看完整公告和网友讨论。卡片和主题提醒要在同一轮完成。\n\n【对话方向】这一步的重点是把玩家引导到论坛页面。第一轮把论坛入口发出去后，这个话题就收束，后续由玩家打开论坛继续。"
goal_description = "告知玩家主题公布，并引导玩家去浏览器查看论坛"
context_data = {
"complete_after_first_reply": true,
"linkchat_open_mode": "force",
"required_cards": [{
"hint": "官方论坛主题讨论页，能看到大家对本届题目的第一波反应",
"title": "帧语大赛 2027 · 主题讨论串",
"type": "web_page",
"url": "framestory://forum/theme"
}],
"story_phase": "day1_afternoon",
"suppress_system_notice": true
}
max_turns = 6
timeout_seconds = 0
on_complete_callback = ""
result_variables = {}
