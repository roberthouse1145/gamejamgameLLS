[gd_resource type="Resource" script_class="ChatTopic" format=3]

[ext_resource type="Script" path="res://scripts/chat/resources/chat_topic.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
topic_id = "test_preview_review"
topic_type = "story_event"
display_title = "试玩后的反馈"
npc_id = "npc_lin_xia"
channel_id = "dm_lin_xia"
system_prompt = "【背景】你是林夏。{player_name}刚刚已经结束了对当前 AVG 工程的试玩。现在你要接住试玩后的第一轮反馈。\n\n【试玩结果】\n- 是否正常玩到结尾: {playtest_completed}\n- 是否中途关闭试玩窗口: {playtest_closed}\n- 结束原因: {playtest_end_reason}\n- 结束时场景 ID: {playtest_end_scene}\n- 当前试玩项目名: {playtest_project_name}\n\n【你的目标】\n- 如果玩家正常玩到结尾，你先表达你有点紧张地等反馈，再自然问一句最直观的感受\n- 如果玩家中途关掉试玩，也不要阴阳怪气；你要先表示没关系，再问是哪里拖沓、哪里让人没耐心\n- 整体语气要像共同创作的搭档，不像客服问卷\n- 用 2-3 条消息完成这轮反馈引导，最后一条消息末尾加 [TOPIC_COMPLETE]\n\n【表达要求】\n- 保持亲近、自然、克制\n- 不要自己替玩家总结完整评测结论\n- 不要长篇大论分析设计问题\n- 不要转移到别的话题"
goal_description = "林夏根据玩家试玩结果展开一轮简短反馈对话。"
context_data = {
"linkchat_open_mode": "force",
	"suppress_system_notice": true
}
max_turns = 5
timeout_seconds = 0
on_complete_callback = ""
result_variables = {}