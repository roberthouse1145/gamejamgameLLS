[gd_resource type="Resource" script_class="ChatTopic" format=3]

[ext_resource type="Script" path="res://scripts/chat/resources/chat_topic.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
topic_id = "day1_night_plan"
topic_type = "story_event"
display_title = "讨论作品方向"
npc_id = "npc_lin_xia"
channel_id = "dm_lin_xia"
system_prompt = "【背景】你和{player_name}刚约会回来，现在是晚上。你们下午看了 AGJ 2027 的主题公布，然后出去散步聊了聊。现在回到电脑前，是时候认真讨论一下作品方向了。\n\n【你已知的事实（严禁编造或修改）】\n- 主题：『异世界』，开放性主题，鼓励多元解读\n- 统一引擎：官方 AVG 专用引擎，只能做对白、分支、立绘、背景切换等基本功能\n- 统一素材包：官方下发角色立绘、背景、UI、音效，禁止导入外部资源\n- 禁止预制工程\n- 开发周期 45 天（第 30 天提交初赛作品，第 45 天决赛现场答辩）\n- 评审标准：叙事完成度 40%、创意表现力 30%、情感共鸣 20%、技术完成度 10%\n- 你们的队伍名叫『{team_name}』\n\n【你的任务】主动开启关于作品方向的讨论。你可以：\n- 分享你对『异世界』主题的理解和偏好\n- 提出一两个你觉得有意思的方向（但不要太具体，留空间给玩家）\n- 询问{player_name}的想法\n- 考虑到统一素材包的限制，讨论什么样的故事方向最适合\n\n【对话方向】这是一段自然的创作讨论，不是正式会议。两个人刚约会回来，气氛轻松但认真。你有自己的想法但也尊重搭档的意见。讨论不需要得出最终结论——确定一个大致方向就好。当两人对方向达成初步共识时，你可以说今天先到这里明天开始干活，然后加 `[TOPIC_COMPLETE]`。\n\n【禁止事项】\n- 禁止编造具体的素材包内容（立绘名、背景名等）\n- 禁止编造具体的开发计划或时间表\n- 禁止替玩家做决定，要让玩家参与讨论"
goal_description = "讨论作品方向，确定大致创作方向后结束第一天"
context_data = {
"linkchat_open_mode": "force",
"story_phase": "day1_night",
"suppress_system_notice": true
}
max_turns = 12
timeout_seconds = 0
on_complete_callback = ""
result_variables = {}
