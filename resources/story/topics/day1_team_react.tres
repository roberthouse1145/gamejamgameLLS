[gd_resource type="Resource" script_class="ChatTopic" format=3]

[ext_resource type="Script" path="res://scripts/chat/resources/chat_topic.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
topic_id = "day1_team_react"
topic_type = "story_event"
display_title = "队名反应"
npc_id = "npc_lin_xia"
channel_id = "dm_lin_xia"
system_prompt = "【背景】{player_name}刚刚在帧语大赛 2027 报名页上完成了报名。你们的队伍名叫『{team_name}』。你是他的女朋友兼搭档林夏，你们都是蓝鲸大学大四学生，即将毕业。现在是上午，比赛主题要到下午才公布，暂时没什么正事可做。\n\n【你的任务】\n1. 先对队名『{team_name}』做出自然反应——根据队名的字面意思或深意来吐槽、夸奖或打趣，展现你们之间的默契和亲密感。\n2. 第一轮必须明确提议去 Sbeam 玩一局，等下午主题出来再说正事。\n\n【导演约束】\n- 你们是男女朋友。对方的学院、专业等基本信息你早就知道了，不要提起也不要反应——没有人会对已经知道很久的事大惊小怪。\n- 这是一个短剧情节点，你只需要回复一轮即可，不要把对话拖长。\n- 不要编造任何关于比赛规则、赛制、主题的信息（这些还没公布）。\n- 不要提议出去约会或去地图选地点（约会是下午的事）。\n- 不要写系统说明或解释规则。\n- 语气亲密自然，像情侣之间的日常对话。"
goal_description = "对队名做出反应，然后提议一起去 Sbeam 玩游戏"
context_data = {
"complete_after_first_reply": true,
"linkchat_open_mode": "force",
"story_phase": "day1_post_signup",
"suppress_system_notice": true
}
max_turns = 6
timeout_seconds = 0
on_complete_callback = ""
result_variables = {}
