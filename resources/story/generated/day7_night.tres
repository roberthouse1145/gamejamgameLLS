[gd_resource type="Resource" script_class="StoryChapter" format=3]

[ext_resource type="Script" path="res://scripts/story/resources/story_chapter.gd" id="1_mtxr6"]
[ext_resource type="Script" path="res://scripts/story/resources/story_step.gd" id="2_psyhc"]

[sub_resource type="Resource" id="Resource_uqtk3"]
script = ExtResource("2_psyhc")
step_id = "day7_night_01_init"
description = "初始化第七天夜晚"
actions = Array[Dictionary]([{
"day": 7,
"phase": "NIGHT",
"type": "set_phase"
}])
next_conditions = Array[Dictionary]([{
"if": "completion < 0",
"next": "day7_night_bad_01_confront"
}, {
"default": true,
"next": "day7_night_02_demo_ready"
}])

[sub_resource type="Resource" id="Resource_v1bqn"]
script = ExtResource("2_psyhc")
step_id = "day7_night_02_demo_ready"
description = "林夏兴奋地告诉玩家 DEMO 可以运行了，邀请试玩"
actions = Array[Dictionary]([{
"npc_speaks_first": true,
"topic_path": "res://resources/story/topics/day7_night_demo_ready.tres",
"type": "activate_topic"
}])
wait_for = {
"topic_id": "day7_night_demo_ready",
"type": "topic_completed"
}
next = "day7_night_03_playtest"

[sub_resource type="Resource" id="Resource_iadl4"]
script = ExtResource("2_psyhc")
step_id = "day7_night_03_playtest"
description = "自动打开 GamePreviewer，从初始场景开始试玩"
actions = Array[Dictionary]([{
"preview_id": "day7_night_demo_preview",
"type": "preview_current_project",
"window_title": "DEMO 试玩"
}])
wait_for = {
"preview_id": "day7_night_demo_preview",
"type": "project_preview_finished"
}
capture = {
"playtest_closed": "payload.closed",
"playtest_completed": "payload.completed",
"playtest_end_reason": "payload.end_reason",
"playtest_end_scene": "payload.scene_id",
"playtest_project_name": "payload.project_name"
}
next = "day7_night_04_close_preview"

[sub_resource type="Resource" id="Resource_4sfna"]
script = ExtResource("2_psyhc")
step_id = "day7_night_04_close_preview"
description = "关闭试玩窗口"
actions = Array[Dictionary]([{
"app_id": "game_previewer",
"force": true,
"type": "close_app"
}])
next = "day7_night_05_review"

[sub_resource type="Resource" id="Resource_rknaq"]
script = ExtResource("2_psyhc")
step_id = "day7_night_05_review"
description = "林夏问玩家试玩感受（氛围对话，不做深入讨论）"
actions = Array[Dictionary]([{
"npc_speaks_first": true,
"topic_path": "res://resources/story/topics/day7_night_review.tres",
"type": "activate_topic"
}])
wait_for = {
"topic_id": "day7_night_review",
"type": "topic_completed"
}
next = "day7_night_06_sleep_invite"

[sub_resource type="Resource" id="Resource_mlp1r"]
script = ExtResource("2_psyhc")
step_id = "day7_night_06_sleep_invite"
description = "林夏撒娇要求一起睡觉"
actions = Array[Dictionary]([{
"npc_speaks_first": true,
"topic_path": "res://resources/story/topics/day7_night_sleep_invite.tres",
"type": "activate_topic"
}])
wait_for = {
"topic_id": "day7_night_sleep_invite",
"type": "topic_completed"
}
capture = {
"sleep_invite_rejected": "result.topic_failed"
}
next_conditions = Array[Dictionary]([{
"if": "sleep_invite_rejected == true",
"next": "day7_night_08_declined_sleep"
}, {
"default": true,
"next": "day7_night_07_sleep_avg"
}])

[sub_resource type="Resource" id="Resource_5vikp"]
script = ExtResource("2_psyhc")
step_id = "day7_night_07_sleep_avg"
description = "一起睡觉 AVG：林夏说心里话，有分支选项，最后睡着"
actions = Array[Dictionary]([{
"generation_transit_stages": ["灯光慢慢暗下来...", "月光透过窗帘洒进房间...", "林夏靠过来了..."],
"generation_transit_title": "晚安",
"generation_transit_window_title": "剧情生成中",
"prompt_key": "story/day7_night_sleep",
"scene_id": "day7_night_sleep",
"title": "晚安",
"type": "play_avg",
"window_title": "晚安"
}])
wait_for = {
"scene_id": "day7_night_sleep",
"type": "avg_scene_ended"
}
capture = {
"sleep_avg_summary": "outcome.summary"
}
next = "day7_night_09_cleanup"

[sub_resource type="Resource" id="Resource_oikr7"]
script = ExtResource("2_psyhc")
step_id = "day7_night_08_declined_sleep"
description = "玩家拒绝一起睡，标记后继续"
actions = Array[Dictionary]([{
"key": "day7_sleep_declined",
"type": "set_variable",
"value": true
}])
next = "day7_night_09_cleanup"

[sub_resource type="Resource" id="Resource_oxta2"]
script = ExtResource("2_psyhc")
step_id = "day7_night_09_cleanup"
description = "收尾：最小化播放器，消耗 AP 进入第二天"
actions = Array[Dictionary]([{
"app_id": "avg_player",
"ignore_missing": true,
"type": "minimize_app_window"
}, {
"action_type": "story",
"amount": 1,
"detail": "day7_night",
"type": "consume_ap"
}])
next = "day7_night_10_done"

[sub_resource type="Resource" id="Resource_fa870"]
script = ExtResource("2_psyhc")
step_id = "day7_night_10_done"
description = "第七天夜晚结束"

[sub_resource type="Resource" id="Resource_apn1n"]
script = ExtResource("2_psyhc")
step_id = "day7_night_bad_01_confront"
description = "林夏在家里发起对峙，表示不想继续做游戏了。"
actions = Array[Dictionary]([{
"npc_speaks_first": true,
"topic_path": "res://resources/story/topics/day7_night_bad_confront.tres",
"type": "activate_topic"
}])
wait_for = {
"topic_id": "day7_night_bad_confront",
"type": "topic_completed"
}
next = "day7_night_bad_02_breakup_avg"

[sub_resource type="Resource" id="Resource_1hdpc"]
script = ExtResource("2_psyhc")
step_id = "day7_night_bad_02_breakup_avg"
description = "坏结局：对峙后的沉默一路走到林夏离开"
actions = Array[Dictionary]([{
"generation_transit_stages": ["房间安静了下来...", "她没有再看你...", "然后她开始收东西..."],
"generation_transit_title": "算了吧",
"generation_transit_window_title": "……",
"prompt_key": "story/day7_night_bad_breakup",
"scene_id": "day7_night_bad_breakup",
"title": "算了吧",
"type": "play_avg",
"window_title": "算了吧"
}])
wait_for = {
"scene_id": "day7_night_bad_breakup",
"type": "avg_scene_ended"
}
next = "day7_night_bad_03_game_over"

[sub_resource type="Resource" id="Resource_fodrw"]
script = ExtResource("2_psyhc")
step_id = "day7_night_bad_03_game_over"
description = "分手线：游戏结束"
actions = Array[Dictionary]([{
"key": "game_over",
"type": "set_variable",
"value": true
}, {
"key": "game_over_reason",
"type": "set_variable",
"value": "bad_ending_breakup"
}])

[resource]
script = ExtResource("1_mtxr6")
chapter_id = "day7_night"
chapter_name = "第七天·夜 - DEMO 试玩与心里话"
description = "林夏宣布 DEMO 可以运行了，邀请玩家试玩；试玩后撒娇要一起睡，睡前说出心里话。若完成度过低则触发坏结局。"
steps = Array[Resource]([SubResource("Resource_uqtk3"), SubResource("Resource_v1bqn"), SubResource("Resource_iadl4"), SubResource("Resource_4sfna"), SubResource("Resource_rknaq"), SubResource("Resource_mlp1r"), SubResource("Resource_5vikp"), SubResource("Resource_oikr7"), SubResource("Resource_oxta2"), SubResource("Resource_fa870"), SubResource("Resource_apn1n"), SubResource("Resource_1hdpc"), SubResource("Resource_fodrw")])
