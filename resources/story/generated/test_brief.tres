[gd_resource type="Resource" script_class="StoryChapter" format=3]

[ext_resource type="Script" path="res://scripts/story/resources/story_chapter.gd" id="1_fyu4h"]
[ext_resource type="Script" path="res://scripts/story/resources/story_step.gd" id="2_xnjka"]

[sub_resource type="Resource" id="Resource_bfa0o"]
script = ExtResource("2_xnjka")
step_id = "test_brief_01_init"
description = "跳过报名流程，直接设置基础变量，开放浏览器"
actions = Array[Dictionary]([{
"day": 2,
"phase": "MORNING",
"type": "set_phase"
}, {
"key": "player_name",
"type": "set_variable",
"value": "测试玩家"
}, {
"key": "player_real_name",
"type": "set_variable",
"value": "张三"
}, {
"key": "team_name",
"type": "set_variable",
"value": "彩虹小队"
}, {
"key": "player_college",
"type": "set_variable",
"value": "蓝鲸大学计算机学院"
}, {
"key": "signup_completed",
"type": "set_variable",
"value": true
}])
next = "test_brief_02_open_brief"

[sub_resource type="Resource" id="Resource_vpw3r"]
script = ExtResource("2_xnjka")
step_id = "test_brief_02_open_brief"
description = "开放APP权限，打开企划卡页面，等待玩家提交"
actions = Array[Dictionary]([{
"type": "open_browser",
"url": "gamejam://brief"
}])
wait_for = {
"key": "creative_brief_submitted",
"type": "variable_equals",
"value": true
}

[resource]
script = ExtResource("1_fyu4h")
chapter_id = "test_brief"
chapter_name = "测试 - 企划卡提交"
description = "测试用章节，跳过day1流程，直接进入企划卡页面，等待玩家填写并提交"
steps = Array[Resource]([SubResource("Resource_bfa0o"), SubResource("Resource_vpw3r")])
