[gd_resource type="Resource" script_class="StoryChapter" format=3]

[ext_resource type="Script" path="res://scripts/story/resources/story_chapter.gd" id="1_bkqpj"]
[ext_resource type="Script" path="res://scripts/story/resources/story_step.gd" id="2_saqdd"]

[sub_resource type="Resource" id="Resource_5dugf"]
script = ExtResource("2_saqdd")
step_id = "test_day1_brief_01_init"
description = "初始化测试环境：让玩家直接处于 Day1 夜晚企划阶段。"
actions = Array[Dictionary]([{
"day": 1,
"phase": "NIGHT",
"type": "set_phase"
}, {
"key": "player_name",
"type": "set_variable",
"value": "测试玩家"
}, {
"key": "player_real_name",
"type": "set_variable",
"value": "张三"
}, {
"key": "team_name",
"type": "set_variable",
"value": "测试小队"
}, {
"key": "player_college",
"type": "set_variable",
"value": "蓝鲸大学计算机学院"
}, {
"key": "signup_completed",
"type": "set_variable",
"value": true
}, {
"key": "gamejam_theme",
"type": "set_variable",
"value": "魔法学院与异世界"
}, {
"apps": ["linkchat", "dev_work"],
"type": "set_app_access"
}, {
"template_path": "res://resources/dev_work/story_tasks/day1_creative_brief.json",
"type": "ensure_dev_work_task"
}, {
"npc_speaks_first": true,
"topic_path": "res://resources/story/topics/day1_night_plan.tres",
"type": "activate_topic"
}, {
"app_id": "linkchat",
"force": true,
"type": "launch_app"
}])
wait_for = {
"topic_id": "day1_night_plan",
"type": "topic_completed"
}
next = "test_day1_brief_02_open_dev_work"

[sub_resource type="Resource" id="Resource_m10ul"]
script = ExtResource("2_saqdd")
step_id = "test_day1_brief_02_open_dev_work"
description = "LinkChat 引导完成后，只打开 Dev Work，不直接启动 minigame。"
actions = Array[Dictionary]([{
"apps": ["linkchat", "dev_work"],
"type": "set_app_access"
}, {
"app_id": "dev_work",
"force": true,
"type": "launch_app"
}])
wait_for = {
"task_id": "day1_creative_brief",
"type": "dev_task_completed"
}

[resource]
script = ExtResource("1_bkqpj")
chapter_id = "test_day1_brief"
chapter_name = "测试 - Day1 企划卡"
description = "测试用章节，跳过 day1 前置流程，直接进入林夏引导玩家打开 Dev Work 完成第一版企划卡。"
steps = Array[Resource]([SubResource("Resource_5dugf"), SubResource("Resource_m10ul")])
