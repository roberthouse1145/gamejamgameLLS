[gd_resource type="Resource" script_class="StoryChapter" format=3]

[ext_resource type="Script" path="res://scripts/story/resources/story_chapter.gd" id="1_bjl77"]
[ext_resource type="Script" path="res://scripts/story/resources/story_step.gd" id="2_70cn7"]

[sub_resource type="Resource" id="Resource_unhki"]
script = ExtResource("2_70cn7")
step_id = "day2_01_init"
description = "进入第二天早晨，解锁所有APP"
actions = Array[Dictionary]([{
"day": 2,
"phase": "MORNING",
"type": "set_phase"
}, {
"crossfade": 2.0,
"path": "res://Assets/sounds/bgm/Blush (loop).ogg",
"type": "play_bgm"
}, {
"mode": "all",
"type": "set_app_access"
}, {
"type": "clear_activity_lock"
}])
next = "day2_02_dev_kickoff"

[sub_resource type="Resource" id="Resource_a0qrt"]
script = ExtResource("2_70cn7")
step_id = "day2_02_dev_kickoff"
description = "林夏告知开发计划：一周内把项目进度推进到10%，但也可以适当放松"
actions = Array[Dictionary]([{
"npc_speaks_first": true,
"topic_path": "res://resources/story/topics/day2_dev_kickoff.tres",
"type": "activate_topic"
}])
wait_for = {
"topic_id": "day2_dev_kickoff",
"type": "topic_completed"
}

[resource]
script = ExtResource("1_bjl77")
chapter_id = "day2"
chapter_name = "第二天 - 开发开始"
description = "企划卡提交后的第二天，解锁所有APP，林夏告知一周内需将项目进度推进到10%"
trigger = {
"day": 2,
"phase": "MORNING",
"required_chapters": ["day1"]
}
steps = Array[Resource]([SubResource("Resource_unhki"), SubResource("Resource_a0qrt")])
