[gd_resource type="Resource" script_class="StoryChapter" format=3]

[ext_resource type="Script" path="res://scripts/story/resources/story_chapter.gd" id="1_xtfld"]
[ext_resource type="Script" path="res://scripts/story/resources/story_step.gd" id="2_snsxt"]

[sub_resource type="Resource" id="Resource_6qjlw"]
script = ExtResource("2_snsxt")
step_id = "test_project_preview_01_init"
description = "初始化测试环境。"
actions = Array[Dictionary]([{
"day": 1,
"phase": "NIGHT",
"type": "set_phase"
}, {
"key": "player_name",
"type": "set_variable",
"value": "测试玩家"
}, {
"key": "player_real_name",
"type": "set_variable",
"value": "张三"
}, {
"key": "team_name",
"type": "set_variable",
"value": "测试小队"
}, {
"key": "player_college",
"type": "set_variable",
"value": "蓝鲸大学计算机学院"
}, {
"key": "signup_completed",
"type": "set_variable",
"value": true
}])
next = "test_project_preview_02_invite"

[sub_resource type="Resource" id="Resource_hl83m"]
script = ExtResource("2_snsxt")
step_id = "test_project_preview_02_invite"
description = "林夏先邀请玩家试玩当前做好的 Demo。"
actions = Array[Dictionary]([{
"npc_speaks_first": true,
"topic_path": "res://resources/story/topics/test_preview_invite.tres",
"type": "activate_topic"
}])
wait_for = {
"topic_id": "test_preview_invite",
"type": "topic_completed"
}
capture = {
"preview_rejected": "result.topic_failed"
}
next_conditions = Array[Dictionary]([{
"if": "preview_rejected == true",
"next": "test_project_preview_06_declined"
}, {
"default": true,
"next": "test_project_preview_03_playtest"
}])

[sub_resource type="Resource" id="Resource_0xvbj"]
script = ExtResource("2_snsxt")
step_id = "test_project_preview_03_playtest"
description = "自动打开 GamePreviewer，直接从当前工程初始场景开始试玩。"
actions = Array[Dictionary]([{
"preview_id": "girlfriend_project_preview",
"type": "preview_current_project",
"window_title": "林夏的试玩版"
}])
wait_for = {
"preview_id": "girlfriend_project_preview",
"type": "project_preview_finished"
}
capture = {
"playtest_closed": "payload.closed",
"playtest_completed": "payload.completed",
"playtest_end_reason": "payload.end_reason",
"playtest_end_scene": "payload.scene_id",
"playtest_project_name": "payload.project_name"
}
next = "test_project_preview_04_close_preview"

[sub_resource type="Resource" id="Resource_vwsco"]
script = ExtResource("2_snsxt")
step_id = "test_project_preview_04_close_preview"
description = "试玩结束或玩家手动关闭后，统一收尾并回到评价对话。"
actions = Array[Dictionary]([{
"app_id": "game_previewer",
"force": true,
"type": "close_app"
}])
next = "test_project_preview_05_review"

[sub_resource type="Resource" id="Resource_7igm3"]
script = ExtResource("2_snsxt")
step_id = "test_project_preview_05_review"
description = "林夏根据玩家是否通关或中途关闭，给出不同语气的反馈。"
actions = Array[Dictionary]([{
"npc_speaks_first": true,
"topic_path": "res://resources/story/topics/test_preview_review.tres",
"type": "activate_topic"
}])
wait_for = {
"topic_id": "test_preview_review",
"type": "topic_completed"
}
next = "test_project_preview_07_done"

[sub_resource type="Resource" id="Resource_1xn60"]
script = ExtResource("2_snsxt")
step_id = "test_project_preview_06_declined"
description = "玩家拒绝试玩，记录分支后结束。"
actions = Array[Dictionary]([{
"key": "project_preview_declined",
"type": "set_variable",
"value": true
}])
next = "test_project_preview_07_done"

[sub_resource type="Resource" id="Resource_lafuk"]
script = ExtResource("2_snsxt")
step_id = "test_project_preview_07_done"
description = "测试结束，占位步骤。"

[resource]
script = ExtResource("1_xtfld")
chapter_id = "test_project_preview"
chapter_name = "测试 - 女友让玩家试玩当前工程"
description = "测试用章节。林夏邀请玩家试玩当前共同制作的 AVG 工程；玩家正常通关或中途关闭试玩窗口后，都会回到聊天进行评价。"
steps = Array[Resource]([SubResource("Resource_6qjlw"), SubResource("Resource_hl83m"), SubResource("Resource_0xvbj"), SubResource("Resource_vwsco"), SubResource("Resource_7igm3"), SubResource("Resource_1xn60"), SubResource("Resource_lafuk")])
