[gd_resource type="Resource" script_class="CharacterProfile" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/game/resources/character_profile.gd" id="1"]
[ext_resource type="Resource" path="res://resources/avg/characters/ruan_yunyou.tres" id="2_avg"]
[ext_resource type="Texture2D" path="res://Assets/images/characters/ruan_yunyou/avatar_linkchat.png" id="3_avatar"]
[ext_resource type="Script" path="res://scripts/apps/linkchat/resources/linkchat_profile.gd" id="4_linkchat"]
[ext_resource type="Script" path="res://scripts/social/resources/social_account_profile.gd" id="7_social"]
[ext_resource type="Resource" path="res://resources/characters/social_posts/ruan_yunyou/first_stream_notice.tres" id="8_stream_post"]
[ext_resource type="Resource" path="res://resources/characters/social_posts/ruan_yunyou/desk_cleanup.tres" id="9_personal_post"]
[ext_resource type="Resource" path="res://resources/live_stream/personas/default_persona.tres" id="10_streamer_persona"]

[sub_resource type="Resource" id="LinkChatProfile_player"]
script = ExtResource("4_linkchat")
account_name = "柚柚"
avatar = ExtResource("3_avatar")

[sub_resource type="Resource" id="SocialAccount_streamer"]
script = ExtResource("7_social")
account_id = "yunyou_streamer"
identity_type = "streamer"
streamer_persona = ExtResource("10_streamer_persona")
handle = "@YuzuRoom"
bio = "新人虚拟主播。开播前会检查三遍设备。"
verified = true
post_contents = Array[Resource]([ExtResource("8_stream_post")])

[sub_resource type="Resource" id="SocialAccount_personal"]
script = ExtResource("7_social")
account_id = "yunyou_personal"
identity_type = "personal"
display_name = "柚柚"
handle = "@yuzu_at_home"
avatar = ExtResource("3_avatar")
bio = "动画、游戏和不太规律的日常。"
post_contents = Array[Resource]([ExtResource("9_personal_post")])

[resource]
script = ExtResource("1")
character_id = "ruan_yunyou"
display_name = "阮云柚"
role = "heroine"
persona_prompt = "{{characters/ruan_yunyou_prompt}}"
avg_character = ExtResource("2_avg")
linkchat_profile = SubResource("LinkChatProfile_player")
social_accounts = Array[Resource]([SubResource("SocialAccount_streamer"), SubResource("SocialAccount_personal")])
