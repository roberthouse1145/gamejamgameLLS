script = ExtResource("2_root")
node_id = "root"
node_name = "Root"
norm_size = Vector2(1, 1)
size = Vector2(2560, 1440)
children = Array[ExtResource("5_node")]([SubResource("event_loop_node")])
command_tabs = [{
"commands": [SubResource("cmd_01"), SubResource("cmd_02"), SubResource("cmd_03"), SubResource("cmd_04"), SubResource("cmd_05"), SubResource("cmd_06"), SubResource("cmd_07"), SubResource("cmd_08"), SubResource("cmd_09"), SubResource("cmd_10"), SubResource("cmd_11"), SubResource("cmd_12"), SubResource("cmd_13"), SubResource("cmd_end")],
"condition_commands": [],
"mode": 0
}]

[resource]
script = ExtResource("1_scene")
scene_id = "scene_05_variable_test"
scene_name = "Variable System Test"
nodes = [SubResource("root_node")]
local_variables = [SubResource("local_var_counter"), SubResource("local_var_luck")]
