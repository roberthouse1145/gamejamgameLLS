[gd_resource type="Resource" script_class="AVGScene" format=3 uid="uid://6cogtqyxlqir"]

[ext_resource type="Script" uid="uid://bp2jf8bgegffx" path="res://scripts/avg/resources/avg_scene.gd" id="1_scene"]
[ext_resource type="Script" uid="uid://bqmt6mnvjwjtl" path="res://scripts/avg/resources/nodes/avg_root_node.gd" id="2_root"]
[ext_resource type="Script" uid="uid://b1pve6xq8ouco" path="res://scripts/avg/resources/avg_command.gd" id="3_cmd"]
[ext_resource type="Script" uid="uid://ddhjo3v5gpfwl" path="res://scripts/avg/resources/avg_node.gd" id="4_node"]
[ext_resource type="Script" uid="uid://drneohd4r71y1" path="res://scripts/avg/resources/avg_style_box.gd" id="5_style"]
[ext_resource type="Script" uid="uid://brnj8wud76qq3" path="res://scripts/avg/resources/avg_variable.gd" id="6_var"]

[sub_resource type="Resource" id="local_var_timer"]
script = ExtResource("6_var")
variable_id = "var_L01"
variable_name = "timer"
description = "Timer counter"

[sub_resource type="Resource" id="local_var_score"]
script = ExtResource("6_var")
variable_id = "var_L02"
variable_name = "score"
description = "Click score"

[sub_resource type="Resource" id="cmd_timer_wait"]
script = ExtResource("3_cmd")
command_type = "WAIT_TIME"
params = {
"duration": 1.0
}

[sub_resource type="Resource" id="cmd_timer_inc"]
script = ExtResource("3_cmd")
command_type = "SET_VARIABLE"
params = {
"operation": "add",
"value": 1,
"variable_id": "var_L01",
"variable_name": "timer"
}

[sub_resource type="Resource" id="cmd_timer_notify"]
script = ExtResource("3_cmd")
command_type = "SET_TEXT"
params = {
"node_id": "",
"text": "Timer: {{local:var_L01}}"
}

[sub_resource type="Resource" id="style_timer_bg"]
script = ExtResource("5_style")
bg_color = Color(0.1, 0.1, 0.3, 0.9)
corner_radius = 12
border_width = 2
border_color = Color(0.4, 0.4, 0.8, 1)
content_margins = Vector4i(16, 8, 16, 8)

[sub_resource type="Resource" id="timer_label"]
script = ExtResource("4_node")
node_id = "node_001"
node_name = "TimerLabel"
norm_position = Vector2(0.03, 0.03)
norm_size = Vector2(0.2, 0.06)
position = Vector2(57.6, 32.4)
size = Vector2(384, 64.8)
command_tabs = [{
"commands": [SubResource("cmd_timer_wait"), SubResource("cmd_timer_inc"), SubResource("cmd_timer_notify")],
"condition_commands": [],
"mode": 1
}]
style_box = SubResource("style_timer_bg")
text = "Timer: 0"
font_size = 28
font_color = Color(0.8, 0.8, 1, 1)
h_alignment = 1
v_alignment = 1

[sub_resource type="Resource" id="cmd_click_add"]
script = ExtResource("3_cmd")
command_type = "SET_VARIABLE"
params = {
"operation": "add",
"value": 1,
"variable_id": "var_L02",
"variable_name": "score"
}

[sub_resource type="Resource" id="cmd_click_notify"]
script = ExtResource("3_cmd")
command_type = "SET_TEXT"
params = {
"node_id": "node_003",
"text": "Score: {{local:var_L02}}"
}

[sub_resource type="Resource" id="style_btn_normal"]
script = ExtResource("5_style")
bg_color = Color(0.2, 0.5, 0.2, 0.9)
corner_radius = 10
border_width = 2
border_color = Color(0.3, 0.7, 0.3, 1)
content_margins = Vector4i(16, 8, 16, 8)

[sub_resource type="Resource" id="click_button"]
script = ExtResource("4_node")
node_id = "node_002"
node_name = "ClickButton"
norm_position = Vector2(0.38, 0.4)
norm_size = Vector2(0.24, 0.1)
position = Vector2(729.6, 432)
size = Vector2(460.8, 108)
command_tabs = [{
"commands": [SubResource("cmd_click_add"), SubResource("cmd_click_notify")],
"condition_commands": [],
"mode": 2
}]
style_box = SubResource("style_btn_normal")
text = "Click Me! (+1 Score)"
font_size = 32
h_alignment = 1
v_alignment = 1

[sub_resource type="Resource" id="style_score_bg"]
script = ExtResource("5_style")
bg_color = Color(0.3, 0.1, 0.1, 0.9)
corner_radius = 12
border_width = 2
border_color = Color(0.8, 0.4, 0.4, 1)
content_margins = Vector4i(16, 8, 16, 8)

[sub_resource type="Resource" id="score_label"]
script = ExtResource("4_node")
node_id = "node_003"
node_name = "ScoreLabel"
norm_position = Vector2(0.75, 0.03)
norm_size = Vector2(0.2, 0.06)
position = Vector2(1440, 32.4)
size = Vector2(384, 64.8)
style_box = SubResource("style_score_bg")
text = "Score: 0"
font_size = 28
font_color = Color(1, 0.8, 0.8, 1)
h_alignment = 1
v_alignment = 1

[sub_resource type="Resource" id="cmd_intro1"]
script = ExtResource("3_cmd")
command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "Parallel Mode Test: Timer + Click Counter"
}

[sub_resource type="Resource" id="cmd_intro2"]
script = ExtResource("3_cmd")
command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "The timer counts up every second. Click the green button to add score."
}

[sub_resource type="Resource" id="root_node"]
script = ExtResource("2_root")
node_id = "root"
node_name = "Root"
norm_size = Vector2(1, 1)
size = Vector2(2560, 1440)
children = Array[ExtResource("4_node")]([SubResource("timer_label"), SubResource("click_button"), SubResource("score_label")])
command_tabs = [{
"commands": [SubResource("cmd_intro1"), SubResource("cmd_intro2")],
"condition_commands": [],
"mode": 0
}]

[resource]
script = ExtResource("1_scene")
scene_id = "scene_006"
scene_name = "Parallel Test"
nodes = [SubResource("root_node")]
local_variables = [SubResource("local_var_timer"), SubResource("local_var_score")]
