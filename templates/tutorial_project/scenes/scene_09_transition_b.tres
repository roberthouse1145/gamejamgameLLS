command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "Background changed to Hotel (wipe_right). Next: wipe_up to Street."
}

[sub_resource type="Resource" id="cmd_bg_wipe_up"]
script = ExtResource("3_cmd")
