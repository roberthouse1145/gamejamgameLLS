params = {
"speaker": "",
"text": "Welcome to Scene B! You arrived via dissolve transition."
}

[sub_resource type="Resource" id="cmd_explain"]
script = ExtResource("3_cmd")
command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "Testing background transitions: wipe_right to Hotel."
}

[sub_resource type="Resource" id="cmd_bg_wipe_right"]
