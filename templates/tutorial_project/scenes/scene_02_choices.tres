params = {
"speaker": "",
"text": "You chose Option A!"
}

[sub_resource type="Resource" id="cmd_choice_b1"]
script = ExtResource("3_cmd")
command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "You chose Option B!"
}

[sub_resource type="Resource" id="cmd_2"]
script = ExtResource("3_cmd")
