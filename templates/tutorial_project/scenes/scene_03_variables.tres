[gd_resource type="Resource" script_class="AVGScene" format=3 uid="uid://cb2ro53i4k1nu"]

[ext_resource type="Script" uid="uid://ddhjo3v5gpfwl" path="res://scripts/avg/resources/avg_node.gd" id="1_i8rq8"]
[ext_resource type="Script" uid="uid://bp2jf8bgegffx" path="res://scripts/avg/resources/avg_scene.gd" id="1_scene"]
[ext_resource type="Script" uid="uid://bqmt6mnvjwjtl" path="res://scripts/avg/resources/nodes/avg_root_node.gd" id="2_root"]
[ext_resource type="Script" uid="uid://b1pve6xq8ouco" path="res://scripts/avg/resources/avg_command.gd" id="3_cmd"]

[sub_resource type="Resource" id="cmd_1"]
script = ExtResource("3_cmd")
command_type = "SET_VARIABLE"
params = {
"operation": "set",
"value": 0,
"variable_name": "score"
}

[sub_resource type="Resource" id="cmd_2"]
script = ExtResource("3_cmd")
command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "Variables can store data. Current score: 0"
}

[sub_resource type="Resource" id="cmd_3"]
script = ExtResource("3_cmd")
command_type = "SET_VARIABLE"
params = {
"operation": "add",
"value": 10,
"variable_name": "score"
}

[sub_resource type="Resource" id="cmd_4"]
script = ExtResource("3_cmd")
command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "Score increased by 10! Now calling an event..."
}

[sub_resource type="Resource" id="cmd_call_event"]
script = ExtResource("3_cmd")
command_type = "CALL_EVENT"
params = {
"event_id": "greeting"
}

[sub_resource type="Resource" id="cmd_after_event"]
script = ExtResource("3_cmd")
command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "Back from event! Score should now be 15."
}

[sub_resource type="Resource" id="if_false_cmd"]
script = ExtResource("3_cmd")
command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "Your score is below 10."
}

[sub_resource type="Resource" id="if_true_cmd"]
script = ExtResource("3_cmd")
command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "Your score is 10 or above. Great job!"
}

[sub_resource type="Resource" id="cmd_if"]
script = ExtResource("3_cmd")
command_type = "IF"
params = {
"condition": "score >= 10",
"else_commands": [SubResource("if_false_cmd")],
"has_else": true,
"if_commands": [SubResource("if_true_cmd")]
}

[sub_resource type="Resource" id="cmd_end"]
script = ExtResource("3_cmd")
command_type = "DIALOGUE"
params = {
"speaker": "",
"text": "That concludes the variables & events tutorial."
}

[sub_resource type="Resource" id="root_node"]
script = ExtResource("2_root")
node_id = "root"
node_name = "Root"
norm_size = Vector2(1, 1)
size = Vector2(2560, 1440)
command_tabs = [{
"commands": [SubResource("cmd_1"), SubResource("cmd_2"), SubResource("cmd_3"), SubResource("cmd_4"), SubResource("cmd_call_event"), SubResource("cmd_after_event"), SubResource("cmd_if"), SubResource("cmd_end")],
"condition_type": 0,
"mode": 0
}]

[resource]
script = ExtResource("1_scene")
scene_id = "scene_03_variables"
scene_name = "Variables & Events"
nodes = [SubResource("root_node")]
