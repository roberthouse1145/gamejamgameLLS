; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="未命名游戏"
run/main_scene="res://scenes/game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

AppManager="*res://autoload/app_manager.gd"
PromptManager="*res://autoload/prompt_manager.gd"
KnowledgeBaseManager="*res://autoload/knowledge_base_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
GameState="*res://autoload/game_state.gd"
StoryDirector="*res://autoload/story_director.gd"
BrowserManager="*res://autoload/browser_manager.gd"
MCPScreenshot="*res://addons/godot_mcp/mcp_screenshot_service.gd"
MCPInputService="*res://addons/godot_mcp/mcp_input_service.gd"
MCPGameInspector="*res://addons/godot_mcp/mcp_game_inspector_service.gd"
TransitManager="*res://autoload/transit_manager.gd"
LiveStreamManager="*res://scenes/autoload/live_stream_manager.tscn"
CardLibraryManager="*res://scenes/autoload/card_library_manager.tscn"
SkillTreeManager="*res://scenes/autoload/skill_tree_manager.tscn"
StreamHistoryManager="*res://scenes/autoload/stream_history_manager.tscn"
MaterialInventoryManager="*res://scenes/autoload/material_inventory_manager.tscn"

[display]

window/size/viewport_width=3840.0
window/size/viewport_height=2160.0
window/size/window_width_override=1920.0
window/size/window_height_override=1080.0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
display/window/dpi/allow_hidpi=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[gui]

theme/custom_font="res://Assets/fonts/AlibabaHealthFont2.0CN-85B.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
