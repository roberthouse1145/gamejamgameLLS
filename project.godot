; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="AI GAME MAKE"
run/main_scene="res://scenes/pseudo_os/desktop.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

StorageManager="*res://autoload/storage_manager.gd"
NarrativeProjectManager="*res://autoload/narrative_project_manager.gd"
AppManager="*res://autoload/app_manager.gd"
PromptManager="*res://autoload/prompt_manager.gd"
#TimeManager="*res://autoload/time_manager.gd"
ChatManager="*res://autoload/chat_manager.gd"
WorkOrderManager="*res://autoload/work_order_manager.gd"
GameLoopManager="*res://autoload/game_loop_manager.gd"
KnowledgeBaseManager="*res://autoload/knowledge_base_manager.gd"
LLMKnowledgeBaseManager="*res://autoload/llm_knowledge_base_manager.gd"
BrowserManager="*res://scenes/autoload/browser_manager.tscn"
GameManager="*res://autoload/game_manager.gd"
DateManager="*res://autoload/date_manager.gd"
PartTimeJobManager="*res://autoload/part_time_job_manager.gd"
SbeamManager="*res://autoload/sbeam_manager.gd"
StoryDirector="*res://autoload/story_director.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=2560
window/size/window_height_override=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
display/window/dpi/allow_hidpi=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
