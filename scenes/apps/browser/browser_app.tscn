[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/browser/browser_app.gd" id="1_browser_app"]
[ext_resource type="Theme" path="res://resources/themes/browser_light.tres" id="2_theme"]

[node name="BrowserApp" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
theme = ExtResource("2_theme")
grow_vertical = 2
script = ExtResource("1_browser_app")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="RootVBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

[node name="ToolBar" type="PanelContainer" parent="RootVBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="ToolBarMargin" type="MarginContainer" parent="RootVBox/ToolBar"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="NavRow" type="HBoxContainer" parent="RootVBox/ToolBar/ToolBarMargin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="AddressDisplay" type="LineEdit" parent="RootVBox/ToolBar/ToolBarMargin/NavRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
editable = false
placeholder_text = "URL"

[node name="TabBar" type="PanelContainer" parent="RootVBox"]
layout_mode = 2

[node name="TabBarMargin" type="MarginContainer" parent="RootVBox/TabBar"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 6

[node name="TabButtons" type="HBoxContainer" parent="RootVBox/TabBar/TabBarMargin"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="NewTabButton" type="Button" parent="RootVBox/TabBar/TabBarMargin/TabButtons"]
unique_name_in_owner = true
layout_mode = 2
text = "+"

[node name="ContentScroll" type="ScrollContainer" parent="RootVBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 1

[node name="ContentMargin" type="MarginContainer" parent="RootVBox/ContentScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="ContentRoot" type="VBoxContainer" parent="RootVBox/ContentScroll/ContentMargin"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="StatusBar" type="PanelContainer" parent="RootVBox"]
layout_mode = 2

[node name="StatusMargin" type="MarginContainer" parent="RootVBox/StatusBar"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 6

[node name="StatusLabel" type="Label" parent="RootVBox/StatusBar/StatusMargin"]
unique_name_in_owner = true
layout_mode = 2
