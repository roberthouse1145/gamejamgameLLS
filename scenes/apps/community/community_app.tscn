[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/community/community_app.gd" id="1_script"]
[ext_resource type="Theme" path="res://resources/themes/browser_light.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="header_style"]
bg_color = Color(0.118, 0.161, 0.247, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_left = 10
corner_radius_bottom_right = 10

[sub_resource type="StyleBoxFlat" id="status_style"]
