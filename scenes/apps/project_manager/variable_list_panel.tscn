[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/project_manager/variable_list_panel.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/editor/property_editor.gd" id="2_property_editor"]

[node name="VariableListPanel" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="TitleLabel" type="Label" parent="."]
layout_mode = 2
text = "变量列表"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="."]
layout_mode = 2

[node name="HSplitContainer" type="HSplitContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
split_offset = 250

[node name="LeftPanel" type="VBoxContainer" parent="HSplitContainer"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2

[node name="Toolbar" type="HBoxContainer" parent="HSplitContainer/LeftPanel"]
unique_name_in_owner = true
layout_mode = 2

[node name="VariableNameInput" type="LineEdit" parent="HSplitContainer/LeftPanel/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "变量名"

[node name="VariableTypeOption" type="OptionButton" parent="HSplitContainer/LeftPanel/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "变量类型"

[node name="AddButton" type="Button" parent="HSplitContainer/LeftPanel/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "+"
tooltip_text = "添加新变量"

[node name="DeleteButton" type="Button" parent="HSplitContainer/LeftPanel/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "-"
tooltip_text = "删除选中变量"

[node name="VariableList" type="ItemList" parent="HSplitContainer/LeftPanel"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="RightPanel" type="VBoxContainer" parent="HSplitContainer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="PropertyLabel" type="Label" parent="HSplitContainer/RightPanel"]
layout_mode = 2
text = "变量属性"

[node name="ScrollContainer" type="ScrollContainer" parent="HSplitContainer/RightPanel"]
layout_mode = 2
size_flags_vertical = 3

[node name="PropertyEditor" type="VBoxContainer" parent="HSplitContainer/RightPanel/ScrollContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("2_property_editor")
