[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/project_manager/scene_list_panel.gd" id="1_script"]

[node name="SceneListPanel" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="TitleLabel" type="Label" parent="."]
layout_mode = 2
text = "场景列表"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="."]
layout_mode = 2

[node name="Toolbar" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="SceneNameInput" type="LineEdit" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "场景名称"

[node name="AddButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "添加"
tooltip_text = "添加新场景"

[node name="DeleteButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "删除"
tooltip_text = "删除选中场景"

[node name="OpenButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "打开"
tooltip_text = "在场景编辑器中打开"

[node name="SceneList" type="ItemList" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
