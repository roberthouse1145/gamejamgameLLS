[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/project_manager/project_settings_panel.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/editor/property_editor.gd" id="2_property_editor"]

[node name="ProjectSettingsPanel" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="TitleLabel" type="Label" parent="."]
layout_mode = 2
text = "项目设置"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="."]
layout_mode = 2

[node name="ProjectNameLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "项目: 未加载"

[node name="HSeparator2" type="HSeparator" parent="."]
layout_mode = 2

[node name="ScrollContainer" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3

[node name="VBoxContainer" type="VBoxContainer" parent="ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="BasicSettingsLabel" type="Label" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "基本设置"
theme_type_variation = &"HeaderMedium"

[node name="PropertyEditor" type="VBoxContainer" parent="ScrollContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("2_property_editor")

[node name="BottomPanel" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Spacer" type="Control" parent="BottomPanel"]
layout_mode = 2
size_flags_horizontal = 3

[node name="SaveButton" type="Button" parent="BottomPanel"]
unique_name_in_owner = true
layout_mode = 2
text = "保存设置"
