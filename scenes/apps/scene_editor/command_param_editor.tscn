[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/scene_editor/command_param_editor.gd" id="1_script"]

[node name="CommandParamEditor" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="TitleLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "命令参数"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="."]
layout_mode = 2

[node name="ScrollContainer" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="ParamsContainer" type="VBoxContainer" parent="ScrollContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="NoParamsLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "选择一个命令以编辑参数"
horizontal_alignment = 1
