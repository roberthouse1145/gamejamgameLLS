[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/scene_editor/scene_file_panel.gd" id="1_script"]

[node name="SceneFilePanel" type="VBoxContainer"]
script = ExtResource("1_script")

[node name="Label" type="Label" parent="."]
layout_mode = 2
text = "场景列表"
horizontal_alignment = 1

[node name="Toolbar" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="NewSceneButton" type="Button" parent="Toolbar"]
layout_mode = 2
text = "+ 场景"

[node name="NewFolderButton" type="Button" parent="Toolbar"]
layout_mode = 2
text = "+ 文件夹"

[node name="DeleteButton" type="Button" parent="Toolbar"]
layout_mode = 2
text = "删除"

[node name="SceneTree" type="Tree" parent="."]
layout_mode = 2
size_flags_vertical = 3
