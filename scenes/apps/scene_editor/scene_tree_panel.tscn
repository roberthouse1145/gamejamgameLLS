[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/scene_editor/scene_tree_panel.gd" id="1_script"]

[node name="SceneTreePanel" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Label" type="Label" parent="."]
layout_mode = 2
text = "场景树"
horizontal_alignment = 1

[node name="Toolbar" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="AddButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "+"
tooltip_text = "添加节点"

[node name="DeleteButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "-"
tooltip_text = "删除节点"

[node name="MoveUpButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "^"
tooltip_text = "上移"

[node name="MoveDownButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "v"
tooltip_text = "下移"

[node name="Tree" type="Tree" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
columns = 2
column_titles_visible = false
hide_folding = false
hide_root = true

[node name="ContextMenu" type="PopupMenu" parent="."]
unique_name_in_owner = true
