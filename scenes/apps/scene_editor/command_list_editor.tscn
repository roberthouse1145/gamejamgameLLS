[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/scene_editor/command_list_editor.gd" id="1_script"]

[node name="CommandListEditor" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Toolbar" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="TypeSelector" type="OptionButton" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "命令类型"

[node name="AddButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "+"
tooltip_text = "添加命令"

[node name="RemoveButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "-"
tooltip_text = "删除命令"

[node name="MoveUpButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "↑"
tooltip_text = "上移"

[node name="MoveDownButton" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "↓"
tooltip_text = "下移"

[node name="CommandList" type="ItemList" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
