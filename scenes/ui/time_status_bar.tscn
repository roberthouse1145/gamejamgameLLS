[sub_resource type="Shader" id="Shader_time_round_clip"]
code = "shader_type canvas_item;\n\nuniform vec2 rect_size = vec2(600.0, 188.0);\nuniform float corner_radius_px : hint_range(0.0, 96.0) = 23.0;\n\nvarying vec2 local_position;\n\nvoid vertex() {\n\tlocal_position = VERTEX;\n}\n\nfloat rounded_rect_distance(vec2 point, vec2 size, float radius) {\n\tvec2 half_size = size * 0.5;\n\tvec2 distance_to_corner = abs(point - half_size) - (half_size - vec2(radius));\n\treturn length(max(distance_to_corner, vec2(0.0))) + min(max(distance_to_corner.x, distance_to_corner.y), 0.0) - radius;\n}\n\nvoid fragment() {\n\tvec4 sampled_color = texture(TEXTURE, UV);\n\tfloat safe_radius = min(corner_radius_px, min(rect_size.x, rect_size.y) * 0.5);\n\tfloat distance = rounded_rect_distance(local_position, rect_size, safe_radius);\n\tfloat antialias_width = max(fwidth(distance), 0.75);\n\tsampled_color.a *= 1.0 - smoothstep(-antialias_width, antialias_width, distance);\n\tCOLOR = sampled_color;\n}\n"

[sub_resource type="ShaderMaterial" id="Material_time_round_clip"]
shader = SubResource("Shader_time_round_clip")

