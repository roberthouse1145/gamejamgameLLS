[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/avg/dev_tools/avg_dev_agent.gd" id="1_agent"]
[ext_resource type="Script" path="res://scripts/llm/AIService.gd" id="2_ai_service"]

[node name="AVGDevAgent" type="Node"]
script = ExtResource("1_agent")
role = "avg_dev_main"
prompt_key = "avg_dev_agent"

[node name="AIService" type="Node" parent="."]
script = ExtResource("2_ai_service")
auto_execute_tools = true
max_tool_iterations = 15
default_max_tokens = 16384
