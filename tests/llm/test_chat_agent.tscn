[gd_scene format=3]

[ext_resource type="Script" path="res://tests/llm/test_chat_agent.gd" id="1_test"]
[ext_resource type="PackedScene" path="res://scenes/llm/chat_agent.tscn" id="2_chat_agent"]

[node name="TestChatAgent" type="Node"]
script = ExtResource("1_test")

[node name="MainAgent" parent="." instance=ExtResource("2_chat_agent")]
role = "chat_default"
prompt_key = "chat_demo"

[node name="FileAgent" parent="." instance=ExtResource("2_chat_agent")]
role = "file_viewer"
prompt_key = "file_viewer"
