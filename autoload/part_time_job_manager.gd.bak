extends Node

signal catalog_refreshed(catalog: Array)
signal catalog_generation_failed(error_msg: String)
signal job_started(session_id: String, payload: Dictionary)
signal transit_started(session_id: String, payload: Dictionary)
signal transit_progress_updated(session_id: String, progress: float, scene_ready: bool)
signal job_scene_generated(session_id: String, package: Dictionary)
signal job_scene_failed(session_id: String, error_msg: String)
signal job_completed(session_id: String, payload: Dictionary)

const ChatTopicClass = preload("res://scripts/chat/resources/chat_topic.gd")
const DateSceneGeneratorClass = preload("res://scripts/date/date_scene_generator.gd")
const DEFAULT_TRANSIT_DURATION: float = 8.0
const TRANSIT_THRESHOLD: float = 0.70
const TRANSIT_CAP: float = 0.85
const TRANSIT_FINISH_SPEED: float = 3.0
const CATALOG_SIZE: int = 3
const DM_CHANNEL_ID: String = "dm_lin_xia"
const DATE_NPC_ID: String = "npc_lin_xia"
const CATALOG_ROLE: String = "part_time_generator"
const FALLBACK_CATALOG_ROLE: String = "chat_default"

var _catalog: Array[Dictionary] = []
var _catalog_week_index: int = -1
var _is_generating_catalog: bool = false
var _session_counter: int = 0
var _pending_sessions: Dictionary = {}
var _moment_request_to_session: Dictionary = {}

var _ai_service: AIService = null
var _moment_ai_service: AIService = null
var _scene_generator: Node = null
var _catalog_request_id: String = ""
var _catalog_llm_enabled: bool = false
var _moment_llm_enabled: bool = false
var _transit_active_session: String = ""


func _ready() -> void:
	name = "PartTimeJobManager"
	_setup_ai_service()
	_setup_moment_ai_service()
	_setup_scene_generator()
	call_deferred("_connect_chat_signals")
	_load_fallback_catalog_if_empty()


func _setup_ai_service() -> void:
	_ai_service = AIService.new()
	_ai_service.name = "PartTimeAIService"
	_ai_service.max_history_messages = 0
	_ai_service.auto_execute_tools = false
	add_child(_ai_service)
	if not _ai_service.request_completed.is_connected(_on_ai_request_completed):
		_ai_service.request_completed.connect(_on_ai_request_completed)
	if not _ai_service.request_failed.is_connected(_on_ai_request_failed):
		_ai_service.request_failed.connect(_on_ai_request_failed)

	var config_mgr := AIConfigManager.new()
	if config_mgr.load_config():
		if not config_mgr.get_config_for_role(CATALOG_ROLE).is_empty():
			_catalog_llm_enabled = config_mgr.apply_to_service(_ai_service, CATALOG_ROLE)
		if not _catalog_llm_enabled and not config_mgr.get_config_for_role(FALLBACK_CATALOG_ROLE).is_empty():
			_catalog_llm_enabled = config_mgr.apply_to_service(_ai_service, FALLBACK_CATALOG_ROLE)
	else:
		_catalog_llm_enabled = false


func _setup_moment_ai_service() -> void:
	_moment_ai_service = AIService.new()
	_moment_ai_service.name = "PartTimeMomentAIService"
	add_child(_moment_ai_service)

	var config_mgr := AIConfigManager.new()
	if config_mgr.load_config():
		_moment_llm_enabled = config_mgr.apply_to_service(_moment_ai_service, "linkchat")
	else:
		_moment_llm_enabled = false

	_moment_ai_service.request_completed.connect(_on_moment_request_completed)
	_moment_ai_service.request_failed.connect(_on_moment_request_failed)


func _setup_scene_generator() -> void:
	# Assume DateSceneGeneratorClass is globally available (it is in date_manager/sbeam_manager)
	_scene_generator = DateSceneGeneratorClass.new()
	_scene_generator.name = "PartTimeSceneGenerator"
	add_child(_scene_generator)
	if not _scene_generator.scene_generated.is_connected(_on_scene_generated):
		_scene_generator.scene_generated.connect(_on_scene_generated)
	if not _scene_generator.scene_failed.is_connected(_on_scene_failed):
		_scene_generator.scene_failed.connect(_on_scene_failed)


func _connect_chat_signals() -> void:
	var chat := _get_chat_manager()
	if chat != null:
		if not chat.topic_completed.is_connected(_on_chat_topic_completed):
			chat.topic_completed.connect(_on_chat_topic_completed)
		if not chat.topic_timeout.is_connected(_on_chat_topic_timeout):
			chat.topic_timeout.connect(_on_chat_topic_timeout)


func get_catalog() -> Array[Dictionary]:
	return _catalog.duplicate(true)


func get_session_snapshot(session_id: String) -> Dictionary:
	if _pending_sessions.has(session_id):
		return _pending_sessions[session_id].duplicate(true)
	return {}


func refresh_weekly_catalog(force: bool = false) -> void:
	var week_index := _get_current_week_index()
	if not force and week_index == _catalog_week_index and not _catalog.is_empty():
		catalog_refreshed.emit(get_catalog())
		return

	if _is_generating_catalog:
		return

	_generate_weekly_catalog(week_index)


func _generate_weekly_catalog(_week_index: int) -> void:
	if _ai_service == null or not _catalog_llm_enabled:
		_load_fallback_catalog_if_empty()
		return

	_is_generating_catalog = true
	var prompt := _load_generation_prompt()
	var sys_prompt := "你是一个严格输出中文 JSON 的游戏策划助手。所有字段内容必须使用中文。"

	_catalog_request_id = _ai_service.chat_simple(prompt, sys_prompt)


func _load_generation_prompt() -> String:
	var path := "res://prompts/part_time_jobs_generation.md"
	if FileAccess.file_exists(path):
		var file := FileAccess.open(path, FileAccess.READ)
		var text := file.get_as_text()
		return text.replace("{count}", str(CATALOG_SIZE))
	return "Generate %d part time jobs as JSON array." % CATALOG_SIZE


func _on_ai_request_completed(request_id: String, response: Dictionary) -> void:
	if request_id != _catalog_request_id:
		return
	
	_catalog_request_id = ""
	_is_generating_catalog = false
	
	var raw_text := AIService.extract_content(response).strip_edges()
	var json_str := _sanitize_json(raw_text)
	
	var json := JSON.new()
	var err := json.parse(json_str)
	if err == OK and json.data is Array and json.data.size() > 0:
		_catalog_week_index = _get_current_week_index()
		_catalog.clear()
		for item in json.data:
			if item is Dictionary:
				item["enabled"] = true
				_catalog.append(item)
		catalog_refreshed.emit(get_catalog())
	else:
		_load_fallback_catalog_if_empty()
		catalog_generation_failed.emit("Failed to parse LLM job catalog JSON.")


func _on_ai_request_failed(request_id: String, error_msg: String, _error_code: int) -> void:
	if request_id != _catalog_request_id:
		return
	_catalog_request_id = ""
	_is_generating_catalog = false
	_load_fallback_catalog_if_empty()
	catalog_generation_failed.emit(error_msg)


func _sanitize_json(text: String) -> String:
	var cleaned := text.strip_edges()
	if cleaned.begins_with("```json"):
		cleaned = cleaned.trim_prefix("```json").strip_edges()
	elif cleaned.begins_with("```"):
		cleaned = cleaned.trim_prefix("```").strip_edges()
	if cleaned.ends_with("```"):
		cleaned = cleaned.trim_suffix("```").strip_edges()
	return cleaned


func _load_fallback_catalog_if_empty() -> void:
	if not _catalog.is_empty():
		return
	var path := "res://resources/data/part_time_jobs.json"
	if FileAccess.file_exists(path):
		var file := FileAccess.open(path, FileAccess.READ)
		var json := JSON.new()
		if json.parse(file.get_as_text()) == OK and json.data is Array:
			for item in json.data:
				if item is Dictionary:
					item["enabled"] = true
					_catalog.append(item)
	catalog_refreshed.emit(get_catalog())


func begin_part_time(job_id: String, transit_duration: float = DEFAULT_TRANSIT_DURATION) -> Dictionary:
	var normalized_id := job_id.strip_edges()
	var job: Dictionary = _find_job_in_catalog(normalized_id)
	if job.is_empty():
		return {"success": false, "error": "未知的兼职岗位"}

	var glm: Node = get_node_or_null("/root/GameLoopManager")
	if glm == null:
		return {"success": false, "error": "GameLoopManager 不可用"}
	if not glm.can_consume_ap(1):
		return {"success": false, "error": "本时段已经行动过了"}
	if not glm.consume_ap(1, "part_time", normalized_id):
		return {"success": false, "error": "鍏艰亴琛屽姩鍚姩澶辫触"}

	var session_id := "part_time_%04d" % (_session_counter + 1)
	_session_counter += 1

	var session: Dictionary = {
		"session_id": session_id,
		"activity_type": "part_time",
		"job_id": normalized_id,
		"job": job.duplicate(true),
		"location_id": normalized_id,
		"location": job.duplicate(true),
		"start_day": _get_current_day(),
		"phase_after_action": _get_phase_name(),
		"detail_prompt": str(job.get("detail_prompt", "")),
		"event_seed": _pick_random_event_seed(job),
		"transit_duration": maxf(transit_duration, 0.01),
		"use_local_fallback": _should_use_local_fallback(),
		"departure_topic_id": "",
		"followup_topic_id": "",
		"moment_request_id": "",
		"departure_done": false,
		"transit_started": false,
		"transit_complete": false,
		"scene_requested": false,
		"scene_ready": false,
		"scene_active": false,
		"scene_failed": false,
		"scene_package": {},
		"scene_outline": "",
		"scene_result": {},
		"scene_window": null,
		"scene_error": "",
		"followup_done": false,
		"moment_done": false,
		"followup_text": "",
		"moment": {},
		"reward_money": int(job.get("reward_money", 0)),
		"settlement_done": false,
		"scene_preview_prompt_key": "part_time_scene_dsl_preview",
		"scene_preview_source_key": "part_time_scene_preview_source",
		"scene_window_title": "涓€璧峰吋鑱岋細%s" % str(job.get("job_title", job.get("title", "鍏艰亴"))),
		"scene_project_prefix": "part_time_scene",
		"scene_review_label": "part-time shift",
	}
	_pending_sessions[session_id] = session
	print("[PartTimeJobManager] Part-time started: %s -> %s" % [session_id, normalized_id])
	
	if _should_generate_scene(session_id):
		_request_scene_generation(session_id)

	_send_player_activity_card(session)
	if bool(session.get("use_local_fallback", false)):
		_send_local_departure_reply(session_id)
		_handle_departure_finished(session_id)
	else:
		if not _start_chat_topic(session_id, "departure"):
			_send_local_departure_reply(session_id)
			_handle_departure_finished(session_id)

	var payload: Dictionary = {
		"success": true,
		"session_id": session_id,
		"location": job,
		"transit_duration": session["transit_duration"],
		"reward_money": int(session.get("reward_money", 0)),
	}
	job_started.emit(session_id, payload)
	return payload


func _find_job_in_catalog(job_id: String) -> Dictionary:
	for job in _catalog:
		if str(job.get("job_id", "")) == job_id:
			return job
	return {}


func _send_player_activity_card(session: Dictionary) -> void:
	var chat := _get_chat_manager()
	if chat == null or not chat.has_method("store_player_message_data"):
		return
	var job: Dictionary = session.get("job", {}) as Dictionary
	var subtitle_parts: Array[String] = []
	var company_name: String = str(job.get("company_name", "")).strip_edges()
	var district: String = str(job.get("district", "")).strip_edges()
	if not company_name.is_empty():
		subtitle_parts.append(company_name)
	if not district.is_empty():
		subtitle_parts.append(district)
	var footer: String = str(job.get("transit_label", "")).strip_edges()
	if footer.is_empty():
		footer = str(job.get("salary_text", "")).strip_edges()
	var ui_data: Dictionary = {
		"speaker": "player",
		"card": {
			"type": "location",
			"title": str(job.get("job_title", job.get("title", "鍏艰亴"))),
			"subtitle": " 璺?".join(subtitle_parts),
			"body": str(job.get("description", "")),
			"footer": footer,
			"badge": "兼职邀约",
			"accent_color": str(job.get("accent_color", "#10B981")),
		}
	}
	chat.store_player_message_data(DM_CHANNEL_ID, ui_data)


func _start_chat_topic(session_id: String, stage: String) -> bool:
	if not _pending_sessions.has(session_id):
		return false
	var chat := _get_chat_manager()
	if chat == null or not chat.has_method("activate_topic") or not chat.has_method("request_topic_npc_reply"):
		return false
	if chat.has_method("has_active_topic") and chat.has_active_topic(DM_CHANNEL_ID):
		return false

	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	var job: Dictionary = session.get("job", {})
	var topic := ChatTopicClass.new()
	topic.topic_id = "%s_%s" % [stage, session_id]
	topic.topic_type = "relationship_event"
	topic.display_title = "%s_%s" % [stage, str(job.get("job_title", "part_time"))]
	topic.npc_id = DATE_NPC_ID
	topic.channel_id = DM_CHANNEL_ID
	topic.system_prompt = _build_topic_prompt(session, stage)
	topic.goal_description = _build_topic_goal(stage)
	topic.max_turns = 1
	topic.timeout_seconds = 120
	topic.context_data = {
		"session_id": session_id,
		"part_time_stage": stage,
		"job_id": str(session.get("job_id", "")),
		"suppress_system_notice": true,
	}

	if not chat.activate_topic(topic):
		return false

	if stage == "departure":
		session["departure_topic_id"] = topic.topic_id
	else:
		session["followup_topic_id"] = topic.topic_id
	_pending_sessions[session_id] = session

	var seed_msg := _build_seed_message(stage)
	if chat.request_topic_npc_reply(DM_CHANNEL_ID, seed_msg, false, true):
		return true

	var topic_mgr: Variant = chat.get("topic_manager")
	if topic_mgr != null:
		var active_topic: ChatTopic = chat.get_active_topic(DM_CHANNEL_ID)
		if active_topic != null and active_topic.topic_id == topic.topic_id:
			topic_mgr.timeout_topic(active_topic)
	return false


func _send_local_departure_reply(session_id: String) -> void:
	if not _pending_sessions.has(session_id):
		return
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	if bool(session.get("departure_done", false)):
		return
	var reply := _build_local_departure_reply(session)

	var chat := _get_chat_manager()
	if chat != null and chat.has_method("store_npc_message"):
		chat.store_npc_message(DM_CHANNEL_ID, DATE_NPC_ID, reply)
	session["departure_done"] = true
	_pending_sessions[session_id] = session


func _store_local_followup(session_id: String) -> void:
	if not _pending_sessions.has(session_id):
		return
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	if bool(session.get("followup_done", false)):
		return

	var reply := _build_local_followup_reply(session)

	var chat := _get_chat_manager()
	if chat != null and chat.has_method("store_npc_message"):
		chat.store_npc_message(DM_CHANNEL_ID, DATE_NPC_ID, reply)

	session["followup_text"] = reply
	session["followup_done"] = true
	_pending_sessions[session_id] = session


func _store_local_moment(session_id: String) -> void:
	if not _pending_sessions.has(session_id):
		return
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	if bool(session.get("moment_done", false)):
		return

	var chat := _get_chat_manager()
	var moment: Dictionary = {}
	if chat != null and chat.has_method("post_moment"):
		var text: String = _build_local_moment_text(session)
		var job: Dictionary = session.get("job", {}) as Dictionary
		moment = chat.post_moment(DATE_NPC_ID, text, str(job.get("moment_hint", "")), 3 + (abs(hash(session_id)) % 9))

	session["moment"] = moment
	session["moment_done"] = true
	_pending_sessions[session_id] = session


func _handle_departure_finished(session_id: String) -> void:
	if not _pending_sessions.has(session_id):
		return
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	if bool(session.get("transit_started", false)):
		return

	session["transit_started"] = true
	session["transit_progress"] = 0.0
	_pending_sessions[session_id] = session
	_transit_active_session = session_id
	set_process(true)

	var payload: Dictionary = {
		"success": true,
		"location": session.get("location", {}),
		"transit_duration": float(session.get("transit_duration", DEFAULT_TRANSIT_DURATION)),
	}
	transit_started.emit(session_id, payload)


func _process(delta: float) -> void:
	if _transit_active_session.is_empty():
		set_process(false)
		return
	_advance_transit(_transit_active_session, delta)


func _advance_transit(session_id: String, delta: float) -> void:
	if not _pending_sessions.has(session_id):
		_transit_active_session = ""
		set_process(false)
		return

	var session: Dictionary = _pending_sessions[session_id]
	var progress: float = float(session.get("transit_progress", 0.0))
	var base_speed: float = 1.0 / maxf(float(session.get("transit_duration", DEFAULT_TRANSIT_DURATION)), 0.1)
	var scene_ready: bool = bool(session.get("scene_ready", false))
	var scene_failed: bool = bool(session.get("scene_failed", false))
	var scene_not_needed: bool = not _should_generate_scene(session_id) and not bool(session.get("scene_requested", false))
	var can_finish: bool = scene_ready or scene_failed or scene_not_needed or bool(session.get("use_local_fallback", false))

	if can_finish or progress < TRANSIT_THRESHOLD:
		var speed_mult: float = TRANSIT_FINISH_SPEED if (can_finish and progress >= TRANSIT_THRESHOLD) else 1.0
		progress += delta * base_speed * speed_mult
	else:
		var room: float = maxf(TRANSIT_CAP - progress, 0.001)
		var full_room: float = TRANSIT_CAP - TRANSIT_THRESHOLD
		var decay: float = sqrt(room / full_room)
		progress += delta * base_speed * decay * 0.8

	progress = clampf(progress, 0.0, 1.0)
	if not can_finish:
		progress = minf(progress, 0.99)

	var session_dup: Dictionary = session.duplicate(true)
	session_dup["transit_progress"] = progress
	_pending_sessions[session_id] = session_dup
	transit_progress_updated.emit(session_id, progress, scene_ready)

	if progress >= 1.0:
		session_dup["transit_complete"] = true
		_pending_sessions[session_id] = session_dup
		_transit_active_session = ""
		set_process(false)
		if scene_ready:
			if _start_scene(session_id):
				return
		_start_followup_phase(session_id)


func _should_generate_scene(session_id: String) -> bool:
	if not _pending_sessions.has(session_id):
		return false
	if _scene_generator == null or not _scene_generator.has_method("generate_for_session"):
		return false
	var session: Dictionary = _pending_sessions[session_id]
	if bool(session.get("use_local_fallback", false)):
		return false
	if bool(session.get("scene_requested", false)) or bool(session.get("scene_ready", false)):
		return false
	return true


func _request_scene_generation(session_id: String) -> void:
	if not _should_generate_scene(session_id):
		return
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	if not _scene_generator.generate_for_session(session_id, session):
		return
	session["scene_requested"] = true
	_pending_sessions[session_id] = session


func _on_scene_generated(session_id: String, package: Dictionary) -> void:
	if not _pending_sessions.has(session_id):
		return
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	session["scene_ready"] = true
	session["scene_failed"] = false
	session["scene_package"] = package.duplicate(true)
	session["scene_outline"] = str(package.get("scene_outline", "")).strip_edges()
	session["scene_error"] = ""
	_pending_sessions[session_id] = session
	job_scene_generated.emit(session_id, package)

	# Elastic transit loop will detect scene_ready and accelerate to 100%.
	# No need to call _start_followup_phase here.


func _on_scene_failed(session_id: String, error: String) -> void:
	if not _pending_sessions.has(session_id):
		return
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	session["scene_failed"] = true
	session["scene_error"] = error
	session["scene_package"] = {}
	session["scene_outline"] = ""
	_pending_sessions[session_id] = session
	job_scene_failed.emit(session_id, error)

	# Elastic transit loop will detect scene_failed and finish.
	# No need to call _start_followup_phase here.


func _start_scene(session_id: String) -> bool:
	if not _pending_sessions.has(session_id):
		return false
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	var scene_package: Dictionary = session.get("scene_package", {}) as Dictionary
	if scene_package.is_empty():
		return false

	var app_manager: Node = get_node_or_null("/root/AppManager")
	var window_manager: Node = app_manager.get("window_manager") if app_manager != null else null
	if window_manager == null or not window_manager.has_method("create_window"):
		return false

	var player_scene: PackedScene = load("res://scenes/date_events/date_event_player.tscn")
	var player_inst := player_scene.instantiate() as Control
	
	var window: Control = window_manager.create_window(str(session.get("scene_window_title", "鍏艰亴鍦烘櫙")), player_inst)
	if window == null:
		player_inst.queue_free()
		return false
	
	window.custom_minimum_size = Vector2(1024, 768)
	window.size = window_manager.get_viewport().get_visible_rect().size * 0.9
	if window.has_method("center_in_screen"):
		window.center_in_screen()

	var minimize_button := window.get_node_or_null("TitleBar/ButtonContainer/MinimizeButton") as Button
	if minimize_button != null:
		minimize_button.visible = false
	var maximize_button := window.get_node_or_null("TitleBar/ButtonContainer/MaximizeButton") as Button
	if maximize_button != null:
		maximize_button.visible = false
	var close_button := window.get_node_or_null("TitleBar/ButtonContainer/CloseButton") as Button
	if close_button != null:
		close_button.visible = false

	if player_inst.has_method("play_scene_package"):
		player_inst.play_scene_package(session_id, scene_package)
		if player_inst.has_signal("playback_finished"):
			player_inst.playback_finished.connect(_on_scene_ended)

	session["scene_active"] = true
	session["scene_window"] = window
	_pending_sessions[session_id] = session
	return true


func _on_scene_ended(session_id: String, outcome: Dictionary) -> void:
	if not _pending_sessions.has(session_id):
		return
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	session["scene_active"] = false
	session["scene_result"] = outcome.duplicate(true)

	var window: Variant = session.get("scene_window", null)
	if window is Control and is_instance_valid(window):
		var app_manager: Node = get_node_or_null("/root/AppManager")
		var window_manager: Node = app_manager.get("window_manager") if app_manager != null else null
		if window_manager != null and window_manager.has_method("close_window"):
			window_manager.close_window(window)
		else:
			(window as Control).queue_free()
	
	session["scene_window"] = null
	_pending_sessions[session_id] = session
	_start_followup_phase(session_id)


func _start_followup_phase(session_id: String) -> void:
	if not _pending_sessions.has(session_id):
		return
	var session: Dictionary = _pending_sessions[session_id]
	if bool(session.get("use_local_fallback", false)):
		_store_local_followup(session_id)
		_store_local_moment(session_id)
		_try_finish_session(session_id)
		return

	if not _start_chat_topic(session_id, "followup"):
		_store_local_followup(session_id)
	if not _start_moment_generation(session_id):
		_store_local_moment(session_id)
	_try_finish_session(session_id)


func _on_chat_topic_completed(topic: ChatTopic, result: Dictionary) -> void:
	if topic == null:
		return
	var context: Dictionary = topic.context_data
	var session_id := str(context.get("session_id", "")).strip_edges()
	if session_id.is_empty() or not _pending_sessions.has(session_id):
		return
	var stage := str(context.get("part_time_stage", "")).strip_edges()
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	
	if stage == "departure":
		session["departure_done"] = true
		_pending_sessions[session_id] = session
		_handle_departure_finished(session_id)
	elif stage == "followup":
		session["followup_done"] = true
		session["followup_text"] = _extract_topic_summary(result)
		_pending_sessions[session_id] = session
		_try_finish_session(session_id)


func _on_chat_topic_timeout(topic: ChatTopic) -> void:
	if topic == null:
		return
	var context: Dictionary = topic.context_data
	var session_id := str(context.get("session_id", "")).strip_edges()
	if session_id.is_empty() or not _pending_sessions.has(session_id):
		return
	var stage := str(context.get("part_time_stage", "")).strip_edges()
	
	if stage == "departure":
		_send_local_departure_reply(session_id)
		_handle_departure_finished(session_id)
	elif stage == "followup":
		_store_local_followup(session_id)
		_try_finish_session(session_id)


func _try_finish_session(session_id: String) -> void:
	if not _pending_sessions.has(session_id):
		return
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	if not bool(session.get("followup_done", false)):
		return
	if not bool(session.get("moment_done", false)):
		return

	_apply_session_settlement(session_id)
	session = (_pending_sessions[session_id] as Dictionary).duplicate(true)

	var payload: Dictionary = {
		"success": true,
		"session_id": session_id,
		"activity_type": str(session.get("activity_type", "part_time")),
		"location": session.get("location", {}),
		"reply": str(session.get("followup_text", "")),
		"moment": session.get("moment", {}),
		"phase_after_action": session.get("phase_after_action", ""),
		"scene_result": session.get("scene_result", {}),
		"reward_money": int(session.get("reward_money", 0)),
	}
	_pending_sessions.erase(session_id)
	job_completed.emit(session_id, payload)


func _apply_session_settlement(session_id: String) -> void:
	if not _pending_sessions.has(session_id):
		return
	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	if bool(session.get("settlement_done", false)):
		return

	var reward_money: int = int(session.get("reward_money", 0))
	var game_manager: Node = get_node_or_null("/root/GameManager")
	if game_manager != null and reward_money != 0 and game_manager.has_method("modify_stat"):
		game_manager.modify_stat("money", reward_money)

	session["settlement_done"] = true
	_pending_sessions[session_id] = session


# Helper functions from DateManager

func _build_topic_prompt(session: Dictionary, stage: String) -> String:
	var job: Dictionary = session.get("job", {})
	var title := str(job.get("job_title", job.get("title", ""))).strip_edges()
	if title.is_empty():
		title = "兼职"
	var company_name := str(job.get("company_name", job.get("title", ""))).strip_edges()
	var detail_prompt := str(session.get("detail_prompt", "")).strip_edges()
	var scene_outline := str(session.get("scene_outline", "")).strip_edges()
	var scene_result: Dictionary = session.get("scene_result", {})
	var parts: Array[String] = [
		"你是林夏。",
		"今晚玩家发来了一份一起兼职的邀约。",
		"兼职岗位: %s" % title,
	]
	if not company_name.is_empty():
		parts.append("店铺 / 公司: %s" % company_name)
	if not detail_prompt.is_empty():
		parts.append("工作设定: %s" % detail_prompt)
	if not scene_result.is_empty():
		parts.append("刚才场景里的玩家选择: %s" % str(scene_result.get("choice_text", "")))
	if not scene_outline.is_empty():
		parts.append("刚才 AVG 场景的文本摘要:\n%s" % scene_outline)
	parts.append("请根据兼职信息和 AVG 文本自然续写，不要套预设模板。")
	if stage == "departure":
		parts.append("当前时刻: 玩家刚把兼职卡片发到 LinkChat，准备和你一起出门上班。")
		parts.append("你现在只需要发一条出发前的即时短消息。")
		parts.append("不要提前总结兼职结果，也不要写成正式工作回复。")
	elif stage == "followup":
		parts.append("当前时刻: 这次兼职已经结束，你正在回宿舍路上或刚刚下班。")
		parts.append("你现在只需要发一条下班后的 followup 短消息。")
		parts.append("让语气自然延续前面的场景，不要写成工作总结。")
	else:
		parts.append("请发送一条自然的短消息。")
	return "\n".join(parts)


func _build_topic_goal(stage: String) -> String:
	if stage == "departure":
		return "发送出发前短消息"
	if stage == "followup":
		return "发送下班后的短消息"
	return "发送短消息"


func _build_seed_message(stage: String) -> String:
	if stage == "departure":
		return "请根据当前话题直接发送出发前回复。"
	if stage == "followup":
		return "请根据当前话题直接发送下班后回复。"
	return "请直接回复。"


func _start_moment_generation(session_id: String) -> bool:
	if not _pending_sessions.has(session_id):
		return false
	if _moment_ai_service == null or not _moment_llm_enabled:
		return false

	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	var request_id := _moment_ai_service.chat_simple(
		_build_moment_user_prompt(session),
		_build_moment_system_prompt()
	)
	if request_id.is_empty():
		return false

	session["moment_request_id"] = request_id
	_pending_sessions[session_id] = session
	_moment_request_to_session[request_id] = session_id
	return true


func _build_moment_system_prompt() -> String:
	return "娴ｇ姵妲搁弸妤€顦撮妴鍌欑稑鐟曚礁褰傛稉鈧弶鈥冲灠缂佹挻娼崗鑹颁捍閸氬海娈戦張瀣几閸﹀牄鈧倸褰ф潻鏂挎礀娑撯偓閺夆€茶厬閺傚洨鍑介弬鍥ㄦ拱閸斻劍鈧緤绱濇稉宥堫洣 JSON閿涘奔绗夌憰浣叫掗柌濠忕礉娑撳秷顩﹂崝鐘茬穿閸欏嚖绱濇稉宥堫洣鐡掑懓绻?6鐎涙ぜ鈧?"


func _build_moment_user_prompt(session: Dictionary) -> String:
	var job: Dictionary = session.get("job", {})
	var title := str(job.get("job_title", job.get("title", ""))).strip_edges()
	var company_name := str(job.get("company_name", job.get("title", ""))).strip_edges()
	var detail_prompt := str(session.get("detail_prompt", "")).strip_edges()
	var event_prompt := ""
	var scene_outline := str(session.get("scene_outline", "")).strip_edges()
	var scene_result: Dictionary = session.get("scene_result", {})
	var parts: Array[String] = [
		"閸忚壈浜村畝妞剧秴: %s" % title,
	]
	if not company_name.is_empty():
		parts.append("鎼存鎽?/ 閸忣剙寰? %s" % company_name)
	if not detail_prompt.is_empty():
		parts.append("閻滄澘婧€鐠佹儳鐣? %s" % detail_prompt)
	if not event_prompt.is_empty():
		parts.append("閺堫剚顐肩紒蹇撳坊: %s" % event_prompt)
	if not scene_result.is_empty():
		parts.append("閻溾晛顔嶉崷銊ユ簚閺咁垶鍣烽惃鍕偓澶嬪: %s" % str(scene_result.get("choice_text", "")))
	if not scene_outline.is_empty():
		parts.append("閸掓碍澧?AVG 閸︾儤娅欓惃鍕瀮閺堫剚鎲宠ぐ?:\n%s" % scene_outline)
	parts.append("鏉堟挸鍤稉鈧弶鈥冲剼娑撳绨￠悵顓炴倵闂呭繑澧滈崣鎴濆毉閻ㄥ嫭婀呴崣瀣箑閿涘苯绻€妞ゅ銆庨惈鈧崚姘閸欐垹鏁撻惃鍕皑閸愭瑱绱濇稉宥堫洣閸愭瑦鍨氬Ο鈩冩緲閵?")
	return "\n".join(parts)


func _extract_topic_summary(result: Dictionary) -> String:
	var summary := str(result.get("summary", "")).replace("[TOPIC_COMPLETE]", "").strip_edges()
	if not summary.is_empty():
		return summary
	var messages: Variant = result.get("messages", [])
	if messages is Array and not messages.is_empty():
		var last_msg: Variant = messages[-1]
		if last_msg is Dictionary:
			return str(last_msg.get("content", "")).replace("[TOPIC_COMPLETE]", "").strip_edges()
		return str(last_msg).replace("[TOPIC_COMPLETE]", "").strip_edges()
	return ""


func _on_moment_request_completed(request_id: String, response: Dictionary) -> void:
	if not _moment_request_to_session.has(request_id):
		return
	var session_id := str(_moment_request_to_session.get(request_id, ""))
	_moment_request_to_session.erase(request_id)
	if session_id.is_empty() or not _pending_sessions.has(session_id):
		return

	var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
	var chat := _get_chat_manager()
	var moment: Dictionary = {}
	var text := _sanitize_generated_text(_extract_ai_text(response))
	if text.is_empty():
		text = _build_local_moment_text(session)
	var job: Dictionary = session.get("job", {}) as Dictionary
	if chat != null and chat.has_method("post_moment"):
		moment = chat.post_moment(DATE_NPC_ID, text, str(job.get("moment_hint", "")), 3 + (abs(hash(session_id)) % 9))

	session["moment_request_id"] = ""
	session["moment"] = moment
	session["moment_done"] = true
	_pending_sessions[session_id] = session
	_try_finish_session(session_id)


func _on_moment_request_failed(request_id: String, _error: String, _error_code: int) -> void:
	if not _moment_request_to_session.has(request_id):
		return
	var session_id := str(_moment_request_to_session.get(request_id, ""))
	_moment_request_to_session.erase(request_id)
	if not session_id.is_empty() and _pending_sessions.has(session_id):
		var session: Dictionary = (_pending_sessions[session_id] as Dictionary).duplicate(true)
		session["moment_request_id"] = ""
		_pending_sessions[session_id] = session
	_store_local_moment(session_id)
	_try_finish_session(session_id)


func _extract_ai_text(response: Dictionary) -> String:
	if response.has("choices") and response.choices is Array and response.choices.size() > 0:
		var message_data: Dictionary = response.choices[0].get("message", {})
		var raw_content: Variant = message_data.get("content", "")
		return str(raw_content)
	return ""


func _sanitize_generated_text(text: String) -> String:
	var cleaned := text.strip_edges()
	if cleaned.begins_with("<thinking>"):
		var end_tag := cleaned.find("</thinking>")
		if end_tag >= 0:
			cleaned = cleaned.substr(end_tag + "</thinking>".length()).strip_edges()
	if cleaned.begins_with("```"):
		var lines: PackedStringArray = cleaned.split("\n")
		if lines.size() >= 3:
			lines.remove_at(0)
			if lines[lines.size() - 1].strip_edges() == "```":
				lines.remove_at(lines.size() - 1)
			cleaned = "\n".join(lines).strip_edges()
	cleaned = cleaned.trim_prefix("\"").trim_suffix("\"").strip_edges()
	if cleaned.contains("\n"):
		cleaned = cleaned.split("\n", false, 1)[0].strip_edges()
	return cleaned


func _build_local_departure_reply(session: Dictionary) -> String:
	var job: Dictionary = session.get("job", {}) as Dictionary
	var job_title: String = str(job.get("job_title", job.get("title", "兼职"))).strip_edges()
	var company_name: String = str(job.get("company_name", "")).strip_edges()
	var district: String = str(job.get("district", "")).strip_edges()
	var variant: int = posmod(abs(hash(str(session.get("session_id", "")) + "_dept")), 3)
	match variant:
		0:
			if not company_name.is_empty():
				return "行，那我收拾一下就过去。今晚这班在%s，对吧？" % company_name
			return "行，那我收拾一下就过去。今晚这班我们一起顶掉。"
		1:
			if not district.is_empty():
				return "好啊，等我一下。去%s之前记得提醒我别迟到。" % district
			return "好啊，等我一下。今晚这班至少不是你一个人扛。"
		_:
			return "可以，%s听起来还行。走吧，今晚一起上班。" % job_title


func _build_local_followup_reply(session: Dictionary) -> String:
	var job: Dictionary = session.get("job", {}) as Dictionary
	var job_title: String = str(job.get("job_title", job.get("title", "兼职"))).strip_edges()
	var choice_text: String = str((session.get("scene_result", {}) as Dictionary).get("choice_text", "")).strip_edges()
	var scene_outline: String = str(session.get("scene_outline", "")).strip_edges()
	var variant: int = posmod(abs(hash(str(session.get("session_id", "")) + "_follow")), 3)
	if not choice_text.is_empty():
		return "刚才你那句“%s”接得还挺自然。做完%s之后，累是累，但心情没那么糟。" % [choice_text, job_title]
	if not scene_outline.is_empty() and variant == 0:
		return "今晚那段配合，现在回头想想还挺像我们会碰上的事。"
	match variant:
		0:
			return "下班以后整个人都松下来了。%s这种事，果然还是两个人一起扛比较像样。" % job_title
		1:
			return "刚才忙的时候没顾上说话，现在回头想想，今晚跟你配合得还挺顺。"
		_:
			return "累归累，但今晚不是那种空掉的累。至少一起把这班撑下来了。"


func _build_local_moment_text(session: Dictionary) -> String:
	var job: Dictionary = session.get("job", {}) as Dictionary
	var company_name: String = str(job.get("company_name", job.get("title", "今晚这班"))).strip_edges()
	var detail_prompt: String = str(session.get("detail_prompt", "")).strip_edges()
	var scene_outline: String = str(session.get("scene_outline", "")).strip_edges()
	var variant: int = posmod(abs(hash(str(session.get("session_id", "")) + "_moment")), 3)
	if not scene_outline.is_empty() and variant == 0:
		return "忙完这一班，回头想想还是觉得有点好笑。"
	match variant:
		0:
			return "今晚在%s忙完，风一吹才发现自己已经累麻了。" % company_name
		1:
			if not detail_prompt.is_empty():
				return "忙了一晚，脑子里还留着%s的味道。" % detail_prompt.substr(0, min(12, detail_prompt.length()))
			return "忙完一整班以后，夜风和安静都变得很珍贵。"
		_:
			return "有些兼职做完只想躺平，但今晚居然还留了点余温。"


func _pick_random_event_seed(data: Dictionary) -> String:
	var seeds: Array = data.get("event_seeds", [])
	if seeds.is_empty():
		return ""
	return str(seeds[randi() % seeds.size()]).strip_edges()


func _pick_text(candidates: Variant, seed_key: String) -> String:
	if not candidates is Array or candidates.is_empty():
		return ""
	return str(candidates[abs(hash(seed_key)) % candidates.size()])


func _get_current_day() -> int:
	var glm: Node = get_node_or_null("/root/GameLoopManager")
	if glm != null: return int(glm.get("current_day"))
	return 1


func _get_current_week_index() -> int:
	return int((_get_current_day() - 1) / 7.0)


func _get_phase_name() -> String:
	var glm: Node = get_node_or_null("/root/GameLoopManager")
	if glm != null and glm.has_method("get_phase_name"):
		return glm.get_phase_name(glm.get("time_phase"))
	return "UNKNOWN"


func _should_use_local_fallback() -> bool:
	if _is_test_scene():
		return true
	return _scene_generator == null or not _scene_generator.has_method("is_available") or not _scene_generator.is_available()


func _get_chat_manager() -> Node:
	return get_node_or_null("/root/ChatManager")


func _is_test_scene() -> bool:
	var tree := get_tree()
	if tree == null or tree.current_scene == null:
		return false
	return str(tree.current_scene.scene_file_path) == "res://test.tscn"
