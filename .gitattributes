# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
*.gd text eol=lf working-tree-encoding=UTF-8
*.tscn text eol=lf working-tree-encoding=UTF-8
*.tres text eol=lf working-tree-encoding=UTF-8
*.godot text eol=lf working-tree-encoding=UTF-8
*.cfg text eol=lf working-tree-encoding=UTF-8
*.json text eol=lf working-tree-encoding=UTF-8
*.md text eol=lf working-tree-encoding=UTF-8
*.txt text eol=lf working-tree-encoding=UTF-8
*.import text eol=lf working-tree-encoding=UTF-8
*.uid text eol=lf working-tree-encoding=UTF-8
*.pck filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
